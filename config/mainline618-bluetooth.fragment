CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
# Bluetooth LE SMP requests cmac(aes), which needs the AES provider.
CONFIG_CRYPTO_AES=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_RFKILL=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_SAMSUNG=m
