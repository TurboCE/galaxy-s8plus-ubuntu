[Unit]
Description=Verify SM-G955N kernel audio endpoint restrictions
Before=systemd-user-sessions.service display-manager.service
ConditionPathExists=/proc/device-tree/samsung,g955n-desktop-audio-scope

[Service]
Type=oneshot
StateDirectory=g955n-native-alsa
ExecStart=/bin/sh -ec 'rm -f /var/lib/g955n-native-alsa/boot-id; grep -aq SM-G955N /proc/device-tree/model; dmesg | grep -Fq "SM-G955N ALSA: native RDMA0/WDMA1 audio scope active"; cat /proc/sys/kernel/random/boot_id > /var/lib/g955n-native-alsa/boot-id'

[Install]
WantedBy=multi-user.target
