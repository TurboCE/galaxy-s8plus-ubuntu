+	pa_log_info("G955N g955n-rdma0-wdma1-ucm-v3 card=%u scope=%d", index, g955n_scope);
+	if (g955n_scope != G955N_PRIMARY) {
+		errno = g955n_scope < 0 ? -g955n_scope : EPERM;
+		return NULL;
+	}
 
 	impl = calloc(1, sizeof(*impl));
 	if (impl == NULL)
@@ -1612,6 +1620,14 @@
 			impl->disable_pro_audio = spa_atob(s);
 	}
 
+	/* Hardware scope precedes UCM/generic/Pro probing, even when policy
+	 * properties are absent or a duplicate WP object has another name. */
+	if (g955n_scope == G955N_PRIMARY) {
+		impl->use_ucm = true;
+		impl->disable_pro_audio = true;
+		impl->rate = 48000;
+	}
+
 	impl->ucm.default_sample_spec.format = PA_SAMPLE_S16NE;
 	impl->ucm.default_sample_spec.rate = impl->rate;
 	impl->ucm.default_sample_spec.channels = 2;
@@ -1635,6 +1651,10 @@
 	res = impl->use_ucm ? pa_alsa_ucm_query_profiles(&impl->ucm, card->index) : -1;
