#include <dt-bindings/soc/samsung,exynos-usi.h>

/* Samsung HSI2C26, shared by the NFC and heart-rate controllers. */
&{/soc@0/usi@10900000} {
	samsung,mode = <USI_MODE_I2C1>;
	status = "okay";
};

&{/soc@0/usi@10900000/i2c@10000} {
	clock-frequency = <100000>;
	status = "okay";
};
