[Unit]
Description=Prepare or restore the SM-G955N GNOME direct output path
Before=g955n-fb-display.service gdm.service gdm3.service display-manager.service
ConditionPathExists=/var/lib/g955n/direct-panel-trial
RequiresMountsFor=/opt/g955n-native-gpu /var/lib/g955n

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/g955n-direct-panel-trial --boot-recover

[Install]
WantedBy=multi-user.target
