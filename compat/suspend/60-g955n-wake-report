#!/bin/sh
[ "$2" = suspend ] || exit 0
grep -aq SM-G955N /proc/device-tree/model || exit 0
printk=/proc/sys/kernel/printk
saved=/run/g955n-suspend-console-level
display_suspend=/run/g955n-display-suspend

record_transition() {
    handler=/usr/local/lib/g955n/g955n-power-key.py
    [ -f "$handler" ] || return 0
    /usr/bin/python3 "$handler" --record "$1" || :
}

case "$1" in
    pre)
        record_transition 'Systemd suspend pre hook'
        printf 'sleeping\n' > "$display_suspend"
        # This kernel briefly switches the display to its reserved suspend VT.
        # Keep ordinary kernel messages in the ring buffer during the switch.
        [ "$(cat /sys/class/tty/tty0/active)" != tty63 ] || exit 0
        [ -c /dev/tty63 ] && [ ! -e "$saved" ] || exit 0
        level=$(awk 'NR == 1 { print $1 }' "$printk") || exit 0
        [ -n "$level" ] || exit 0
        (umask 077; printf '%s\n' "$level" > "$saved") || exit 0
        printf '1\n' > "$printk" || { rm -f "$saved"; exit 0; }
        printf '\033[2J\033[H' > /dev/tty63
        exit 0
        ;;
    post)
        record_transition 'Systemd suspend post hook'
        # /proc/uptime uses the same clock as the reader's input event timestamps.
        awk 'NR == 1 {print $1}' /proc/uptime > "$display_suspend.new" &&
            mv -f "$display_suspend.new" "$display_suspend"
        if [ -f "$saved" ]; then
            read -r level < "$saved"
            current=$(awk 'NR == 1 { print $1 }' "$printk")
            [ "$current" != 1 ] || printf '%s\n' "$level" > "$printk"
            rm -f "$saved"
        fi
        ;;
    *)
        exit 0
        ;;
esac

# systemd invokes post hooks while user sessions can still be frozen.
irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null) || irq=
case "$irq" in
    ''|*[!0-9]*)
        printf 'g955n-suspend: wake IRQ unavailable\n'
        record_transition 'Wake IRQ unavailable'
        ;;
    *)
        source=$(awk -v irq="$irq:" '
            $1 == irq {
                for (i = 2; i <= NF; i++) {
                    if ($i == "Edge" || $i == "Level") {
                        sub("^.*[[:space:]]" $i "[[:space:]]+", "")
                        print
                        exit
                    }
                }
            }
        ' /proc/interrupts)
        printf 'g955n-suspend: wake IRQ %s (%s)\n' "$irq" "${source:-unknown}"
        record_transition "Wake IRQ $irq"
        case "$source" in
            'Power'|'gpio-keys: KEY_POWER')
                if systemctl is-active --quiet g955n-power-key.service; then
                    # Brief presses can end before the resumed input driver samples them.
                    # Access the display after systemd unfreezes the graphical session.
                    systemd-run --quiet --collect --on-active=2s \
                        --unit=g955n-wake-display-after-button /usr/bin/python3 \
                        /usr/local/lib/g955n/g955n-power-key.py --wake
                fi
                ;;
        esac
        ;;
esac
