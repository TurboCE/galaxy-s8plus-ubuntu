+static gboolean
+ambient_can_adjust (GsdPowerManager *manager)
+{
+        return manager->backlight && manager->iio_proxy &&
+               manager->session_is_active &&
+               manager->current_idle_mode <= GSD_POWER_IDLE_MODE_NORMAL &&
+               !manager->ambient_panel_blank &&
+               g_settings_get_boolean (manager->settings, "ambient-enabled");
+}
+
+static gboolean
+ambient_ramp_step (gpointer user_data)
+{
+        GsdPowerManager *manager = user_data;
+        gint current, next;
+
+        if (!ambient_can_adjust (manager) || manager->ambient_norm_required)
+                goto stop;
+
+        current = gsd_backlight_get_brightness (manager->backlight, NULL);
+        if (current < 0 || current == manager->ambient_target)
+                goto stop;
+
+        /* Wait for the previous write to reach the hardware. */
+        if (manager->ambient_pending >= 0 && current != manager->ambient_pending) {
+                if (g_get_monotonic_time () < manager->ambient_step_deadline)
+                        return G_SOURCE_CONTINUE;
+                goto stop;
+        }
+
+        /* Rate-limit brightness, not the measured lux. An on-change sensor
+         * can report one large jump and then deliver no more samples. */
+        next = current + CLAMP (manager->ambient_target - current, -3, 3);
+        gsd_backlight_set_brightness_async (manager->backlight, next, NULL, NULL, NULL);
+        manager->ambient_pending = next;
+        manager->ambient_step_deadline = g_get_monotonic_time () + G_TIME_SPAN_SECOND;
+        return G_SOURCE_CONTINUE;
+
+stop:
+        manager->ambient_ramp_id = 0;
+        return G_SOURCE_REMOVE;
+}
