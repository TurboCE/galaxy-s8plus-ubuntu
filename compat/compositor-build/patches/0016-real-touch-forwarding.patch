+struct g955n_touch_origin {
+	struct wlr_surface *surface;
+	double x, y;
+	bool found;
+};
+static void g955n_find_surface(struct wlr_scene_buffer *buffer, int sx, int sy, void *data) {
+	struct g955n_touch_origin *origin = data;
+	struct wlr_scene_surface *surface = wlr_scene_surface_try_from_buffer(buffer);
+	if (surface && surface->surface == origin->surface) {
+		origin->x = sx; origin->y = sy; origin->found = true;
+	}
+}
+static void g955n_touch_down(struct wl_listener *listener, void *data) {
+	struct tinywl_server *server = wl_container_of(listener, server, touch_down);
+	struct wlr_touch_down_event *event = data;
+	double lx, ly, sx, sy;
+	wlr_cursor_absolute_to_layout_coords(server->cursor, &event->touch->base,
+		event->x, event->y, &lx, &ly);
+	struct wlr_surface *surface = NULL;
+	struct tinywl_toplevel *top = desktop_toplevel_at(server, lx, ly, &surface, &sx, &sy);
+	if (surface) {
+		focus_toplevel(top, surface);
+		uint32_t serial = wlr_seat_touch_notify_down(server->seat, surface, event->time_msec, event->touch_id, sx, sy);
+		wlr_log(WLR_DEBUG, "G955N real touch down id=%d serial=%u xy=%.1f,%.1f", event->touch_id, serial, sx, sy);
+	}
+}
+static void g955n_touch_motion(struct wl_listener *listener, void *data) {
+	struct tinywl_server *server = wl_container_of(listener, server, touch_motion);
+	struct wlr_touch_motion_event *event = data;
+	struct wlr_touch_point *point = wlr_seat_touch_get_point(server->seat, event->touch_id);
+	if (!point || !point->surface) return;
+	struct g955n_touch_origin origin = {.surface = point->surface};
+	wlr_scene_node_for_each_buffer(&server->scene->tree.node, g955n_find_surface, &origin);
+	if (!origin.found) { wlr_seat_touch_notify_cancel(server->seat, point->surface); return; }
+	double lx, ly;
+	wlr_cursor_absolute_to_layout_coords(server->cursor, &event->touch->base,
+		event->x, event->y, &lx, &ly);
+	wlr_seat_touch_notify_motion(server->seat, event->time_msec, event->touch_id, lx-origin.x, ly-origin.y);
+}
+static void g955n_touch_up(struct wl_listener *listener, void *data) {
+	struct tinywl_server *server = wl_container_of(listener, server, touch_up);
+	struct wlr_touch_up_event *event = data;
+	wlr_seat_touch_notify_up(server->seat, event->time_msec, event->touch_id);
+}
+static void g955n_touch_cancel(struct wl_listener *listener, void *data) {
+	struct tinywl_server *server = wl_container_of(listener, server, touch_cancel);
+	struct wlr_touch_cancel_event *event = data;
+	struct wlr_touch_point *point = wlr_seat_touch_get_point(server->seat, event->touch_id);
+	if (point && point->surface) wlr_seat_touch_notify_cancel(server->seat, point->surface);
+}
+static void g955n_touch_frame(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct tinywl_server *server = wl_container_of(listener, server, touch_frame);
+	wlr_seat_touch_notify_frame(server->seat);
 }
 
