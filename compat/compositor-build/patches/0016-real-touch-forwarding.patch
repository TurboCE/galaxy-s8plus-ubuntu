+static void g955n_pointer_destroy(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct tinywl_pointer *pointer = wl_container_of(listener, pointer, destroy);
+	assert(pointer->server->pointer_count > 0);
+	pointer->server->pointer_count--;
+	if (!pointer->server->pointer_count) wlr_seat_pointer_clear_focus(pointer->server->seat);
+	wl_list_remove(&pointer->destroy.link);
+	g955n_touch_caps(pointer->server);
+	free(pointer);
+}
+
 static void server_new_pointer(struct tinywl_server *server,
 		struct wlr_input_device *device) {
 	/* We don't do anything special with pointers. All of our pointer handling
 	 * is proxied through wlr_cursor. On another compositor, you might take this
 	 * opportunity to do libinput configuration on the device to set
 	 * acceleration, etc. */
+	struct tinywl_pointer *pointer = calloc(1, sizeof(*pointer));
+	if (!pointer) return;
+	pointer->server = server;
+	pointer->destroy.notify = g955n_pointer_destroy;
+	wl_signal_add(&device->events.destroy, &pointer->destroy);
+	server->pointer_count++;
 	wlr_cursor_attach_input_device(server->cursor, device);
+}
+
+/* Forward real touchscreen contacts through wl_touch. No virtual input device. */
+static void g955n_touch_caps(struct tinywl_server *server) {
+	uint32_t caps = server->pointer_count ? WL_SEAT_CAPABILITY_POINTER : 0;
+	if (!wl_list_empty(&server->keyboards)) caps |= WL_SEAT_CAPABILITY_KEYBOARD;
+	if (!wl_list_empty(&server->touches)) caps |= WL_SEAT_CAPABILITY_TOUCH;
+	wlr_seat_set_capabilities(server->seat, caps);
+}
+
+static void g955n_touch_destroy(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct tinywl_touch *touch = wl_container_of(listener, touch, destroy);
+	while (!wl_list_empty(&touch->server->seat->touch_state.touch_points)) {
+		struct wlr_touch_point *point = wl_container_of(touch->server->seat->touch_state.touch_points.next, point, link);
+		if (point->surface) wlr_seat_touch_notify_cancel(touch->server->seat, point->surface);
+		else wlr_seat_touch_notify_up(touch->server->seat, 0, point->touch_id);
+	}
+	wl_list_remove(&touch->destroy.link);
+	wl_list_remove(&touch->link);
+	g955n_touch_caps(touch->server);
+	free(touch);
+}
+
+static void g955n_new_touch(struct tinywl_server *server, struct wlr_input_device *device) {
+	struct tinywl_touch *touch = calloc(1, sizeof(*touch));
+	if (!touch) return;
+	touch->server = server;
+	touch->destroy.notify = g955n_touch_destroy;
+	wl_signal_add(&device->events.destroy, &touch->destroy);
+	wl_list_insert(&server->touches, &touch->link);
+	wlr_cursor_attach_input_device(server->cursor, device);
+	wlr_log(WLR_INFO, "G955N real touchscreen attached: %s", device->name);
 }
 
