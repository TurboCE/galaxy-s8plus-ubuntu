From: SM-G955N Ubuntu port contributors
Subject: [PATCH] es2gears fixture: report real GL renderer after current context

Original per-file MIT notices are retained. No GL interception or result change.

--- a/src/egl/opengles2/es2gears.c
+++ b/src/egl/opengles2/es2gears.c
@@ -541,6 +541,8 @@
    eglutInit(argc, argv);
 
    eglutCreateWindow("es2gears");
+   printf("GL_RENDERER = %s\n", glGetString(GL_RENDERER));
+   fflush(stdout);
 
    /* Set up eglut callback functions */
    eglutIdleFunc(gears_idle);
