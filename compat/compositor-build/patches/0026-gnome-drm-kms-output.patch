Subject: Present the GNOME overlay through standard DRM KMS and PRIME

--- a/hybris/egl/platforms/x11/x11_window.cpp
+++ b/hybris/egl/platforms/x11/x11_window.cpp
@@ -45,6 +45,7 @@
 #include <sys/stat.h>
 extern "C" {
 #include "decon-output.h"
+#include "drm-output.h"
 }
 
 #if ANDROID_VERSION_MAJOR>=4 && ANDROID_VERSION_MINOR>=2 || ANDROID_VERSION_MAJOR>=5
@@ -391,6 +392,7 @@
                                const X11NativeWindowBuffer *buffer)
 {
     static int panel = -1, lease = -1, previous_fence = -1;
+    static g955n_kms *kms;
     static unsigned retired;
     static Window output = None;
     static bool rejected;
@@ -453,13 +455,36 @@
             close(lease);
             return false;
         }
