+	if (!_eglCreateSyncKHR) {
+		HYBRIS_ERROR("X11 transfer requires real EGL fence synchronization");
+		_exit(33);
+	}
 	if (_eglCreateSyncKHR) {
 		/* The buffer is copied or imported by the X server right after this,
 		 * so rendering must have finished on the GPU. */
 		EGLSyncKHR sync = (*_eglCreateSyncKHR)(dpy, EGL_SYNC_FENCE_KHR, NULL);
-		if (sync != EGL_NO_SYNC_KHR) {
-			(*_eglClientWaitSyncKHR)(dpy, sync, EGL_SYNC_FLUSH_COMMANDS_BIT_KHR, EGL_FOREVER_KHR);
-			(*_eglDestroySyncKHR)(dpy, sync);
+		if (sync == EGL_NO_SYNC_KHR ||
+			(*_eglClientWaitSyncKHR)(dpy, sync, EGL_SYNC_FLUSH_COMMANDS_BIT_KHR, 1000000000ULL) != EGL_CONDITION_SATISFIED_KHR) {
+			HYBRIS_ERROR("X11 rendering fence failed/timed out");
+			_exit(33);
 		}
+		(*_eglDestroySyncKHR)(dpy, sync);
 	}
 	window->finishSwap();
 }
