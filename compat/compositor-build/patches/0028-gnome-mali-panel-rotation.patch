+#ifdef G955N_NATIVE_ROTATION
+static bool g955n_panel_rotation(Display *display, unsigned int *degrees)
+{
+    XRRScreenResources *resources = XRRGetScreenResourcesCurrent(display, DefaultRootWindow(display));
+    if (!resources)
+        return false;
+    bool ok = false;
+    for (int i = 0; i < resources->noutput && !ok; ++i) {
+        XRROutputInfo *output = XRRGetOutputInfo(display, resources, resources->outputs[i]);
+        if (!output)
+            continue;
+        if (output->connection == RR_Connected && output->nameLen == 5 &&
+            !memcmp(output->name, "DSI-1", 5) && output->crtc) {
+            XRRCrtcInfo *crtc = XRRGetCrtcInfo(display, resources, output->crtc);
+            if (crtc && crtc->mode && crtc->x == 0 && crtc->y == 0) {
+                switch (crtc->rotation) {
+                case RR_Rotate_0:   *degrees = 0;   ok = true; break;
+                case RR_Rotate_90:  *degrees = 90;  ok = true; break;
+                case RR_Rotate_180: *degrees = 180; ok = true; break;
+                case RR_Rotate_270: *degrees = 270; ok = true; break;
+                }
+            }
+            if (crtc)
+                XRRFreeCrtcInfo(crtc);
+        }
+        XRRFreeOutputInfo(output);
+    }
+    XRRFreeScreenResources(resources);
+    return ok;
+}
+#endif
