#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>

&{/soc@0/usi@10860000} {
	samsung,mode = <USI_MODE_I2C1>;
	status = "okay";
};

&{/soc@0/usi@10860000/i2c@10000} {
	clock-frequency = <100000>;
	status = "okay";

	pmic@60 {
		compatible = "samsung,sm-g955n-s2dos03-optical";
		status = "okay";

		regulators {
			ppg_vdd: ldo2 {
				regulator-name = "adpd143-vdd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			ppg_vled: ldo4 {
				regulator-name = "adpd143-vled";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};
		};
	};
};

&{/soc@0/usi@10900000/i2c@10000} {
	optical@64 {
		compatible = "samsung,sm-g955n-adpd143";
		reg = <0x64>;
		interrupt-parent = <&{/soc@0/pinctrl@10980000/gpe6-gpio-bank}>;
		interrupts = <6 IRQ_TYPE_EDGE_FALLING>;
		vdd-supply = <&ppg_vdd>;
		vled-supply = <&ppg_vled>;
	};
};
