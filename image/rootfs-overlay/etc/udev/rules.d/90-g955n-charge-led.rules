# Refresh after power changes and when the indicators appear during boot.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="max77865-battery|max77865-wired|max77865-wireless", RUN+="/usr/local/sbin/g955n-charge-led"
ACTION=="add", SUBSYSTEM=="leds", KERNEL=="red:indicator|green:indicator", RUN+="/usr/local/sbin/g955n-charge-led"
