[Unit]
Description=SM-G955N Broadcom location and sensor hub on Linux 6.18
ConditionKernelVersion=6.18.*-g955n-*
ConditionKernelCommandLine=g955n.bcm4773=1
After=local-fs.target systemd-udev-trigger.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=/usr/sbin/modprobe g955n_bcm4773_ssi expose_legacy_stream=1 expose_legacy_control=1 expose_legacy_patch=1 expose_legacy_power=1 probe_legacy_ssp=1 expose_legacy_accel=1 expose_legacy_environment=1
ExecStart=/usr/local/sbin/g955n-location-hub --mainline
ExecStopPost=/usr/local/sbin/g955n-location-hub --power-off
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
UMask=0077
PrivateMounts=yes
ProtectSystem=full
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
