#!/usr/bin/env python3
"""Legacy DECON framebuffer presentation for native console/fbdev bring-up.

This commits the fbdev framebuffer to the command-mode panel; rendering may
come from CPU or the private Mali X11 bridge. It does not itself render with
the GPU. Keep its fd open. A future HWC/DRM compositor
must replace this service rather than compete for the same display plane.
"""
import fcntl
import mmap
import os
from pathlib import Path
import signal
import struct
import stat
import subprocess
import sys
import time
import zlib

def pan_with_trial_lease(fd, var):
    """Keep the legacy scanout ready while an explicit test owns the panel."""
    path = '/run/lock/g955n-direct-panel-trial'
    try:
        lease = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except FileNotFoundError:
        fcntl.ioctl(fd, 0x4606, var, True)
        return True
    try:
        policy = os.fstat(lease)
        if not stat.S_ISREG(policy.st_mode) or policy.st_uid != 0 or policy.st_mode & 0o022:
            raise RuntimeError('Invalid direct panel trial lease')
        try:
            fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        fcntl.ioctl(fd, 0x4606, var, True)
        return True
    finally:
        os.close(lease)


def x11_panel_off():
    """Read the native X server's real DPMS state; empty Samsung sysfs is unknown.

    xset runs in a disposable process so an X server restart cannot invoke an
    Xlib fatal-I/O handler inside the persistent framebuffer owner.
    """
    off = False
    for proc in Path('/proc').glob('[0-9]*'):
        try:
            args = (proc / 'cmdline').read_bytes().split(b'\0')
            if args[0] != b'/usr/lib/xorg/Xorg' or b'-auth' not in args:
                continue
            auth = Path(os.fsdecode(args[args.index(b'-auth')+1]))
            info = auth.lstat()
            if not stat.S_ISREG(info.st_mode) or info.st_uid not in (105, 1000) or info.st_mode & 0o077:
                continue
            for sock in Path('/tmp/.X11-unix').glob('X[0-9]*'):
                display = ':' + sock.name[1:]
                result = subprocess.run(['/usr/bin/xset', '-display', display, '-q'],
                    env={'PATH':'/usr/bin:/bin','LC_ALL':'C','XAUTHORITY':str(auth)},
                    text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=1)
                if result.returncode:
                    continue
                if 'Monitor is On' in result.stdout:
                    return False
                if any('Monitor is ' + value in result.stdout for value in ('Off','Standby','Suspend')):
                    off = True
        except (OSError, ValueError, subprocess.SubprocessError):
            continue
    return True if off else None


if 'SM-G955N' not in Path('/proc/device-tree/model').read_text():
    raise SystemExit('Wrong device model')
running = True


def stop(*_):
    global running
    running = False


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
fd = os.open('/dev/fb0', os.O_RDWR)
try:
    var, fix = bytearray(160), bytearray(80)
    fcntl.ioctl(fd, 0x4600, var, True)  # FBIOGET_VSCREENINFO
    fcntl.ioctl(fd, 0x4602, fix, True)  # FBIOGET_FSCREENINFO
    width, height, virtual_width, virtual_height, x, y, bpp = struct.unpack_from('7I', var)
    stride = struct.unpack_from('I', fix, 48)[0]
    size = stride * height
    capacity = struct.unpack_from('I', fix, 24)[0]
    if (width, height, bpp) != (1440, 2960, 32) or not 0 < size <= capacity:
        raise SystemExit('Unexpected primary framebuffer geometry')
    struct.pack_into('II', var, 16, 0, 0)
    if x11_panel_off() is not True:
        fcntl.ioctl(fd, 0x4611, 0)  # FBIOBLANK / UNBLANK
    with mmap.mmap(fd, size, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ) as pixels:
        if os.environ.get('G955N_FB_PAN_HZ') == '60':
            # The proven S8 X11 path needs regular DECON commits. Do not scan
            # all 17 MB of write-combined framebuffer memory on the hot path.
            # An ioctl count is not a measured rendering/panel FPS result.
            next_pan = time.monotonic()
            stats_at = next_pan
            next_blank_check = 0.0
            blanked = False
            pans = 0
            print('Native X11 panel commit pump active: requested 60 Hz', flush=True)
            while running:
                now = time.monotonic()
                # Samsung's blank file is empty. Read authoritative parent
                # runtime PM before every pan; query X only if it is unknown.
                # The kernel must still serialize MMIO against power-down.
                try:
                    power = Path('/sys/class/graphics/fb0/device/power/runtime_status').read_text().strip()
                except OSError:
                    power = ''
                if power in {'active', 'suspended', 'suspending', 'resuming'}:
                    blanked = power != 'active'
                elif now >= next_blank_check:
                    try:
                        level = Path('/sys/class/graphics/fb0/blank').read_text().strip()
                        blanked = level in {'1','2','3','4'}
                        if not level:
                            blanked = x11_panel_off() is True
                    except OSError:
                        blanked = False
                    next_blank_check = now + 1.0
                if blanked:
                    time.sleep(0.25)
                    next_pan = time.monotonic()
                    continue
                if not pan_with_trial_lease(fd, var):
                    # The direct GNOME output owns the panel. Wait for it
                    # to release the lease before resuming legacy commits.
                    time.sleep(0.25)
                    next_pan = time.monotonic()
                    continue
                pans += 1
                next_pan = max(next_pan + 1.0 / 60.0, time.monotonic())
                time.sleep(max(0.001, next_pan - time.monotonic()))
                if now - stats_at >= 30:
                    print('Panel commit interval: requests=%d seconds=%.1f; not measured rendered FPS' % (pans, now-stats_at), flush=True)
                    stats_at = now
                    pans = 0
        elif os.environ.get('G955N_FB_XDAMAGE') != '1':
            # Keep the previously working baseline until the later kernel
            # corruption is diagnosed. The faster path is explicit opt-in.
            previous = None
            print('Native CPU framebuffer legacy presentation active; GPU remains unqualified', flush=True)
            while running:
                checksum = zlib.crc32(pixels)
                if checksum != previous:
                    fcntl.ioctl(fd, 0x4606, var, True)
                    previous = checksum
                time.sleep(0.2)
        else:
            from concurrent.futures import ThreadPoolExecutor
            # Observe X damage in disposable subprocesses. Never let X server
            # shutdown close this framebuffer fd or exit the presenter itself.
            monitor = None
            try:
                sys.path.insert(0, '/usr/local/lib/g955n')
                from g955n_xdamage import DamageMonitor
                monitor = DamageMonitor()
            except Exception as error:
                print('X damage unavailable; retaining checksum fallback: ' + type(error).__name__, flush=True)
            previous = sparse_previous = None
            pending = True
            next_pan = next_check = next_sparse = 0.0
            mode = None
            pans = damages = full_checks = 0
            stats_at = time.monotonic()
            # Full-frame WC-memory reads are expensive. Keep safety scans off the
            # presentation loop, and use them infrequently while X damage works.
            with ThreadPoolExecutor(max_workers=1, thread_name_prefix='fb-check') as executor:
                future = None
                try:
                    print('Native CPU framebuffer presentation active; GPU remains unqualified', flush=True)
                    while running:
                        dirty = False
                        if monitor is not None:
                            try:
                                dirty = monitor.poll()
                            except Exception as error:
                                print('Damage observer failed; checksum fallback: ' + type(error).__name__, flush=True)
                                monitor.close()
                                monitor = None
                        ready = monitor is not None and monitor.ready
                        current_mode = 'xdamage-30hz' if ready else 'checksum-fallback'
                        if current_mode != mode:
                            print('Framebuffer mode: ' + current_mode, flush=True)
                            mode = current_mode
                            next_check = 0.0
                            pending = True
                        now = time.monotonic()
                        if dirty:
                            pending = True
                            damages += 1
                        if ready and now >= next_sparse:
                            # Sample all RGB byte lanes at fixed page intervals.
                            # This is only a low-cost safety signal; it cannot replace
                            # X damage or the periodic complete checksum.
                            sample = 0
                            for lane in range(3):
                                sample = zlib.crc32(pixels[lane::4096], sample)
                            if sample != sparse_previous:
                                pending = True
                                sparse_previous = sample
                            next_sparse = now + 0.2
                        if future is not None and future.done():
                            checksum = future.result()
                            future = None
                            full_checks += 1
                            if checksum != previous:
                                pending = True
                                previous = checksum
                            next_check = time.monotonic() + (2.0 if ready else 0.2)
                        if future is None and now >= next_check:
                            future = executor.submit(zlib.crc32, pixels)
                        if pending and now >= next_pan:
                            pan_started = time.monotonic()
                            fcntl.ioctl(fd, 0x4606, var, True)
                            pending = False
                            pans += 1
                            # Space request starts, rather than adding another full
                            # interval after a blocking driver/vblank wait.
                            next_pan = pan_started + 1.0 / 30.0
                        if now - stats_at >= 60:
                            print('Framebuffer interval: mode=%s pan_requests=%d damage_batches=%d full_checks=%d; requests are not measured panel FPS' %
                                  (mode, pans, damages, full_checks), flush=True)
                            stats_at = now
                            pans = damages = full_checks = 0
                        time.sleep(1.0 / 60.0)
                finally:
                    if monitor is not None:
                        monitor.close()
finally:
    os.close(fd)
