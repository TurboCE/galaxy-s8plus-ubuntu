From: SM-G955N Ubuntu port contributors
Subject: [PATCH] ikconfig: embed the actual configuration instead of S8 stock

The vendor tree hardcodes dreamlte stock defconfig for /proc/config.gz.
That reports gzip support even when the compiled G955N kernel only has LZ4,
making hardware diagnosis unreliable. Embed the configuration actually built.

diff --git a/kernel/Makefile b/kernel/Makefile
--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -121,9 +121,8 @@ $(obj)/configs.o: $(obj)/config_data.h
 
 # config_data.h contains the same information as ikconfig.h but gzipped.
 # Info from config_data can be extracted from /proc/config*
-KCONFIG_CONFIG_STOCK = arch/arm64/configs/exynos8895-dreamlte_defconfig
 targets += config_data.gz
-$(obj)/config_data.gz: $(KCONFIG_CONFIG_STOCK) FORCE
+$(obj)/config_data.gz: $(KCONFIG_CONFIG) FORCE
 	$(call if_changed,gzip)
 
       filechk_ikconfiggz = (echo "static const char kernel_config_data[] __used = MAGIC_START"; cat $< | scripts/basic/bin2c; echo "MAGIC_END;")
