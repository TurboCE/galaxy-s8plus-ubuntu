Subject: [PATCH] mmc: dw_mmc: report SD identification command outcomes on request

Enable the optional diagnostic to distinguish a missing card response
from errors later in enumeration on kernels built without tracing.
Report the controller status without card data or identification fields.

diff --git a/drivers/mmc/host/dw_mmc.c b/drivers/mmc/host/dw_mmc.c
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -39,6 +39,10 @@
 
 #include "dw_mmc.h"
 
+static bool trace_sd_identification;
+module_param(trace_sd_identification, bool, 0400);
+MODULE_PARM_DESC(trace_sd_identification, "Log SD identification command status");
+
 /* Common flag combinations */
 #define DW_MCI_DATA_ERROR_FLAGS	(SDMMC_INT_DRTO | SDMMC_INT_DCRC | \
 				 SDMMC_INT_HTO | SDMMC_INT_SBE  | \
@@ -1953,6 +1957,12 @@
 		cmd->error = -EIO;
 	else
 		cmd->error = 0;
+
+	if (trace_sd_identification &&
+	    (cmd->opcode == MMC_GO_IDLE_STATE || cmd->opcode == SD_SEND_IF_COND ||
+	     cmd->opcode == MMC_APP_CMD || cmd->opcode == SD_APP_OP_COND))
+		dev_info_ratelimited(host->dev, "SD identification CMD%u error=%d status=%#x\n",
+				     cmd->opcode, cmd->error, status);
 
 	return cmd->error;
 }
