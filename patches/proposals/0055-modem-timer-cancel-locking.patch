Subject: modem_v1: release modem lock while waiting for timer callbacks

TX and zero-copy allocation callbacks take mc->lock. A synchronous timer
cancel under that same lock can wait indefinitely for the running callback.
Try cancellation under the lock and release it before retrying. The normal
timer start and queue serialization are retained.

--- a/drivers/misc/modem_v1/link_device_memory.h
+++ b/drivers/misc/modem_v1/link_device_memory.h
@@ -39,6 +39,25 @@
 #include "include/circ_queue.h"
 #include "include/sbd.h"
 #include "include/sipc5.h"
+
+/* Called from boot/reset process context. Timer callbacks take mc->lock,
+ * so retry with that lock released if the callback is already running.
+ * Keep each cancellation attempt serialized with the normal timer starters.
+ */
+static inline void cancel_modem_timer(struct modem_ctl *mc,
+				      struct hrtimer *timer)
+{
+	unsigned long flags;
+	int ret;
+
+	do {
+		spin_lock_irqsave(&mc->lock, flags);
+		ret = hrtimer_try_to_cancel(timer);
+		spin_unlock_irqrestore(&mc->lock, flags);
+		if (ret < 0)
+			cpu_relax();
+	} while (ret < 0);
+}
 
