Subject: [PATCH] ASoC: make CS47L92/93 selectable for board bring-up

Allow a standalone build of the existing codec driver while
the SM-G955N machine link is under development.

diff --git a/sound/soc/codecs/Kconfig b/sound/soc/codecs/Kconfig
--- a/sound/soc/codecs/Kconfig
+++ b/sound/soc/codecs/Kconfig
@@ -1054,7 +1054,7 @@
 	depends on MFD_CS47L90
 
 config SND_SOC_CS47L92
-	tristate
+	tristate "Cirrus Logic CS47L92/93 codec"
 	depends on MFD_CS47L92
 
 config SND_SOC_CS48L32
