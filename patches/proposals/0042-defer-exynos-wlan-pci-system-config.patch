Subject: Defer PCI config access while the Exynos WLAN bus is powered off

The vendor WLAN driver powers off the bus in ordinary suspend and brings
it back in ordinary resume. The Exynos host caches and restores the root
port configuration, and DHD does the same for the endpoint. The generic
noirq transitions run between those callbacks with config access down.
Use host state for the opt-in Wi-Fi port to avoid those accesses. Leave
other ports unchanged and keep the driver callbacks that restore the bus.

--- a/include/linux/pci.h
+++ b/include/linux/pci.h
@@ -582,6 +582,8 @@
 	void __iomem *(*map_bus)(struct pci_bus *bus, unsigned int devfn, int where);
 	int (*read)(struct pci_bus *bus, unsigned int devfn, int where, int size, u32 *val);
 	int (*write)(struct pci_bus *bus, unsigned int devfn, int where, int size, u32 val);
+	/* Optional check for host-managed power during system sleep. */
+	bool (*sleep_config_available)(struct pci_bus *bus);
 };
 
 /*
--- a/drivers/pci/host/pcie-designware.h
+++ b/drivers/pci/host/pcie-designware.h
@@ -63,6 +63,7 @@
 	int (*wr_other_conf)(struct pcie_port *pp, struct pci_bus *bus,
 			unsigned int devfn, int where, int size, u32 val);
 	int (*link_up)(struct pcie_port *pp);
+	bool (*sleep_config_available)(struct pcie_port *pp);
 	void (*host_init)(struct pcie_port *pp);
 	void (*msi_set_irq)(struct pcie_port *pp, int irq);
 	void (*msi_clear_irq)(struct pcie_port *pp, int irq);
--- a/drivers/pci/host/pcie-designware.c
+++ b/drivers/pci/host/pcie-designware.c
@@ -706,9 +706,18 @@
 	return ret;
 }
 
+static bool dw_pcie_sleep_config_available(struct pci_bus *bus)
+{
+	struct pcie_port *pp = bus->sysdata;
+
+	return !pp->ops->sleep_config_available ||
+		pp->ops->sleep_config_available(pp);
+}
+
 static struct pci_ops dw_pcie_ops = {
 	.read = dw_pcie_rd_conf,
 	.write = dw_pcie_wr_conf,
+	.sleep_config_available = dw_pcie_sleep_config_available,
 };
 
 void dw_pcie_setup_rc(struct pcie_port *pp)
--- a/drivers/pci/host/pci-exynos.c
+++ b/drivers/pci/host/pci-exynos.c
@@ -1019,7 +1019,20 @@
 	return 0;
 }
 
+static bool exynos_pcie_sleep_config_available(struct pcie_port *pp)
+{
+	struct exynos_pcie *exynos_pcie = to_exynos_pcie(pp);
+
+	if (!of_property_read_bool(pp->dev->of_node,
+				   "samsung,driver-managed-sleep"))
+		return true;
+
+	/* The WLAN driver powers off this host and restores it on resume. */
+	return READ_ONCE(exynos_pcie->state) == STATE_LINK_UP;
+}
+
 static struct pcie_host_ops exynos_pcie_host_ops = {
+	.sleep_config_available = exynos_pcie_sleep_config_available,
 	.rd_own_conf = exynos_pcie_rd_own_conf,
 	.wr_own_conf = exynos_pcie_wr_own_conf,
 	.rd_other_conf = exynos_pcie_rd_other_conf,
