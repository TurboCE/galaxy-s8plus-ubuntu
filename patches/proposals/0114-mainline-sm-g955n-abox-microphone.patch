-		.cpus = &speaker->cpu, .num_cpus = 1,
+		.cpus = &speaker->cpu[0], .num_cpus = 1,
 		.platforms = &speaker->platform, .num_platforms = 1,
-		.codecs = &speaker->codec, .num_codecs = 1,
