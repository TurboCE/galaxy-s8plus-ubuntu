+		.stream_name = "Internal Microphone",
+		.cpus = &speaker->cpu[1], .num_cpus = 1,
+		.platforms = &speaker->platform, .num_platforms = 1,
+		.codecs = &speaker->codec[1], .num_codecs = 1,
+		.dai_fmt = SND_SOC_DAIFMT_I2S | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_CBC_CFC,
+		.capture_only = 1, .nonatomic = 1,
+		.init = g955n_mic_init, .ops = &g955n_mic_ops,
 	};
 	speaker->card = (struct snd_soc_card) {
-		.name = "SM-G955N Speaker",
-		.owner = THIS_MODULE,
-		.dev = dev,
-		.dai_link = &speaker->link,
-		.num_links = 1,
+		.name = "SM-G955N Audio",
+		.driver_name = "g955n-audio",
+		.owner = THIS_MODULE, .dev = dev,
+		.dai_link = speaker->link, .num_links = ARRAY_SIZE(speaker->link),
+		.dapm_widgets = mic_widgets, .num_dapm_widgets = ARRAY_SIZE(mic_widgets),
+		.dapm_routes = mic_routes, .num_dapm_routes = ARRAY_SIZE(mic_routes),
 	};
-	ret = devm_snd_soc_register_component(dev, &speaker_component, &speaker_dai, 1);
