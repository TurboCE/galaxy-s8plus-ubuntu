+	if (ret)
+		return ret;
+	speaker->cpu[0].name = dev_name(dev);
+	speaker->cpu[0].dai_name = speaker_dai[0].name;
+	speaker->cpu[1].name = dev_name(dev);
+	speaker->cpu[1].dai_name = speaker_dai[1].name;
 	speaker->platform.name = dev_name(dev);
-	speaker->codec.of_node = codec;
-	speaker->codec.dai_name = "max98506-hifi";
