+	speaker->codec[0].of_node = codec;
+	speaker->codec[0].dai_name = "max98506-hifi";
+	speaker->codec[1].of_node = mic;
+	speaker->codec[1].dai_name = "cs47l92-aif1";
+	speaker->link[0] = (struct snd_soc_dai_link) {
 		.name = "Internal Speaker",
