Subject: [PATCH] iio: qualify a pending BCM4773 SSI payload

After the hardware HOST_REQ signal, follow Samsung's two-transfer
SSI receive sequence. Bound the probe to 254 payload bytes and
require the second header to report data. Record the payload byte
count without logging its contents or registering an IIO device.

diff --git a/drivers/iio/common/g955n-bcm4773-wake.c b/drivers/iio/common/g955n-bcm4773-wake.c
--- a/drivers/iio/common/g955n-bcm4773-wake.c
+++ b/drivers/iio/common/g955n-bcm4773-wake.c
@@ -8,6 +8,8 @@
 #include <linux/spi/spi.h>
 
 #define BCM4773_SSI_READ_HD 0x20
+#define BCM4773_SSI_MAX_PIO_PAYLOAD 254
+#define BCM4773_SSI_HEADER_SIZE 2
 
 static bool gnss_power;
 module_param(gnss_power, bool, 0400);
@@ -21,15 +23,22 @@
  * Qualify the board power and GPIO handshake before attaching a BBD client.
  * The diagnostic releases its supply and leaves the MCU request inactive.
  */
-static int g955n_bcm4773_read_header(struct spi_device *spi)
+static int g955n_bcm4773_read_pending(struct spi_device *spi)
 {
 	struct device *dev = &spi->dev;
-	struct spi_transfer transfer = { .len = 2, .bits_per_word = 8, .speed_hz = 1000000 };
+	const unsigned int buffer_size = BCM4773_SSI_HEADER_SIZE +
+					 BCM4773_SSI_MAX_PIO_PAYLOAD;
+	struct spi_transfer transfer = {
+		.len = BCM4773_SSI_HEADER_SIZE,
+		.bits_per_word = 8,
+		.speed_hz = 1000000,
+	};
+	unsigned int limit, received;
 	u8 *tx, *rx;
 	int ret;
 
-	tx = devm_kzalloc(dev, transfer.len, GFP_KERNEL);
-	rx = devm_kzalloc(dev, transfer.len, GFP_KERNEL);
+	tx = devm_kzalloc(dev, buffer_size, GFP_KERNEL);
+	rx = devm_kzalloc(dev, buffer_size, GFP_KERNEL);
 	if (!tx || !rx)
 		return -ENOMEM;
 
@@ -43,8 +52,27 @@
 	dev_info(dev, "BCM4773 SSI header status=0x%02x length=%u\n", rx[0], rx[1]);
 	if (rx[0])
 		return -EPROTO;
-	/* A zero header alone could be an undriven data line. */
-	return rx[1] ? 0 : -ENODATA;
+
+	/*
+	 * The Samsung BBD transport performs a second receive from the
+	 * start of the frame. HOST_REQ is asserted, so use its bounded
+	 * PIO fallback if the initial header reports zero bytes.
+	 */
+	limit = min_t(unsigned int, rx[1] ?: BCM4773_SSI_MAX_PIO_PAYLOAD,
+		      BCM4773_SSI_MAX_PIO_PAYLOAD);
+	transfer.len = BCM4773_SSI_HEADER_SIZE + limit;
+	ret = spi_sync_transfer(spi, &transfer, 1);
+	if (ret)
+		return ret;
+	if (rx[0])
+		return -EPROTO;
+
+	received = min_t(unsigned int, rx[1], limit);
+	if (!received)
+		return -ENODATA;
+
+	dev_info(dev, "BCM4773 received %u SSI payload bytes\n", received);
+	return 0;
 }
 
 static int g955n_bcm4773_wake_probe(struct spi_device *spi)
@@ -140,13 +168,13 @@
 					1000, 250000, false, host_request);
 		host_idle = ret == -ETIMEDOUT;
 		if (!ret) {
-			phase = "SSI header";
-			ret = level < 0 ? level : g955n_bcm4773_read_header(spi);
+			phase = "SSI frame";
+			ret = level < 0 ? level : g955n_bcm4773_read_pending(spi);
 		}
 	}
 	gpiod_set_value_cansleep(request, 0);
 	if (!ret)
-		dev_info(dev, "BCM4773 wake and SSI header received\n");
+		dev_info(dev, "BCM4773 wake and SSI frame received\n");
 	else if (host_idle) {
 		dev_info(dev, "BCM4773 did not signal pending SSI data\n");
 		ret = 0;
