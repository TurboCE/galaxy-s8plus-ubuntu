+	ROUTE_CTRL0, SPUS_CTRL0, SPUS_CTRL1, SPUS_BANK0,
 	UAIF4_CTRL0, UAIF4_CTRL1, RDMA0_CTRL0, RDMA0_START, RDMA0_END,
 	RDMA0_PERIOD, RDMA0_POINT, RDMA0_VOL,
 };
 
 static const u32 capture_regs[] = {
-	SYSPOWER_CTRL, CAP_ROUTE, CAP_SPUM0, CAP_SPUM1, CAP_BANK0,
+	CAP_ROUTE, CAP_SPUM0, CAP_SPUM1, CAP_BANK0,
 	CAP_UAIF0, CAP_UAIF0 + 4, CAP_DMA, CAP_DMA + 8,
 	CAP_DMA + 12, CAP_DMA + 16, CAP_DMA + 20, CAP_DMA + 24,
 };
 
-struct g955n_speaker {
-	struct device *dev;
-	struct regmap *pmu;
+struct g955n_speaker;
+
+struct g955n_pcm {
+	struct g955n_speaker *abox;
