+					       period_work);
 
 	u32 status;
 	unsigned int offset, period;
 
-	if (!READ_ONCE(speaker->running))
+	if (!READ_ONCE(pcm->running))
 		return;
-	status = readl(speaker->sfr + dma_status(speaker));
+	status = readl(pcm->abox->sfr + dma_status(pcm));
 	offset = ((status & GENMASK(28, 16)) >> 12) + (status & GENMASK(12, 0));
 	period = offset / PERIOD_BYTES;
-	if (period != speaker->period) {
-		speaker->period = period;
-		snd_pcm_period_elapsed(speaker->stream);
+	if (period != pcm->period) {
+		pcm->period = period;
+		snd_pcm_period_elapsed(pcm->stream);
 	}
-	if (READ_ONCE(speaker->running))
-		schedule_delayed_work(&speaker->period_work, msecs_to_jiffies(5));
+	if (READ_ONCE(pcm->running))
