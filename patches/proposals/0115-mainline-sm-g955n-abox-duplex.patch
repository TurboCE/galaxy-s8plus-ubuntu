+	struct snd_soc_dai_link_component cpu[2], codec[2], platform;
+	struct g955n_pcm pcm[2];
+	struct mutex prepare_lock;
+	unsigned int prepared_count;
+	u32 saved_syspower;
+};
+
+static struct g955n_pcm *abox_pcm(struct snd_soc_component *component,
+				  struct snd_pcm_substream *stream)
+{
+	struct g955n_speaker *abox = container_of(component->card, struct g955n_speaker, card);
+
+	return &abox->pcm[stream->stream];
+}
+
 static void abox_update(void __iomem *base, u32 reg, u32 mask, u32 value)
 {
 	writel((readl(base + reg) & ~mask) | value, base + reg);
 }
 
