-	bool capture;
-	void __iomem *sfr;
-	void __iomem *cmu;
 	unsigned int period;
 	struct snd_dma_buffer ring;
-	struct snd_soc_card card;
-	struct snd_soc_dai_link link[2];
-	struct snd_soc_dai_link_component cpu[2], codec[2], platform;
 	struct snd_pcm_substream *stream;
 	struct delayed_work period_work;
 	unsigned long previous_bclk;
 	u32 saved[ARRAY_SIZE(saved_regs)];
 	u32 saved_gate;
+	bool capture;
 	bool prepared;
 	bool running;
 	bool poisoned;
 };
 
+struct g955n_speaker {
