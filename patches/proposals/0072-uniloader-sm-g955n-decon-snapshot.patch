Subject: [PATCH] uniLoader: report SM-G955N inherited DECON0 scanout routing

Provide an opt-in read-only snapshot for a DRM/KMS takeover trial.
Record the window routing and, when one running DMA window is
unambiguous, record its channel's shadow format, geometry and address.

Apply after the SM-G955N G3D clock snapshot proposal.

--- a/board/samsung/board-dream2lteks.c
+++ b/board/samsung/board-dream2lteks.c
@@ -71,6 +71,77 @@
 }
 
 /*
+ * Snapshot the live DECON0 window routing. Read the DPP shadow registers
+ * only for an enabled non-colormap window that actually feeds DECON0.
+ * The snapshot is optional and never modifies the inherited scanout.
+ */
+static void dream2lteks_record_decon(void *fdt, int chosen)
+{
+	const uintptr_t decon = 0x12860000;
+	const uintptr_t shadow = decon + 0x7000;
+	const char *prop = "samsung,g955n-decon-snapshot";
+	/* DECON route selector to DMA register block, from Samsung's DPU helper. */
+	static const unsigned int channel_to_idma[] = { 2, 4, 5, 1, 3, 0 };
+	fdt32_t snapshot[15];
+	uint32_t power, global, windows, channels;
+	unsigned int selected = 6;
+	int len;
+
+	if (!fdt_getprop(fdt, chosen, prop, &len) || len != sizeof(snapshot))
+		return;
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(snapshot); i++)
+		snapshot[i] = cpu_to_fdt32(0xffffffff);
+	power = readl((const volatile uint32_t *)0x16484064);
+	snapshot[0] = cpu_to_fdt32(power);
+	if ((power & 0xf) != 0xf)
+		goto publish;
+
+	global = readl((const volatile uint32_t *)decon);
+	windows = readl((const volatile uint32_t *)(shadow + 0x0214));
+	channels = readl((const volatile uint32_t *)(shadow + 0x0218));
+	snapshot[1] = cpu_to_fdt32(global);
+	snapshot[2] = cpu_to_fdt32(readl((const volatile uint32_t *)(decon + 0x70)));
+	snapshot[3] = cpu_to_fdt32(windows);
+	snapshot[4] = cpu_to_fdt32(channels);
+	/* A running output with one routed window gives an unambiguous DPP. */
+	if ((global & 0x10) == 0)
+		goto publish;
+	for (unsigned int win = 0; win < 6; win++) {
+		if (((windows >> (4 * win)) & 3) != 1)
+			continue;
+		if (selected != 6)
+			goto publish;
+		selected = win;
+	}
+	if (selected != 6) {
+		unsigned int channel = (channels >> (4 * selected)) & 7;
+		const uintptr_t window = shadow + 0x1000 + 0x30 * selected;
+
+		snapshot[5] = cpu_to_fdt32(selected);
+		snapshot[6] = cpu_to_fdt32(channel);
+		snapshot[7] = cpu_to_fdt32(readl((const volatile uint32_t *)(window + 8)));
+		snapshot[8] = cpu_to_fdt32(readl((const volatile uint32_t *)(window + 12)));
+		if (channel < ARRAY_SIZE(channel_to_idma)) {
+			const uintptr_t idma_base =
+				0x128b1000 + 0x1000 * channel_to_idma[channel];
+			const uintptr_t idma = idma_base + 0x800;
+
+			snapshot[9] = cpu_to_fdt32(readl((const volatile uint32_t *)(idma + 8)));
+			snapshot[10] = cpu_to_fdt32(readl((const volatile uint32_t *)(idma + 0x10)));
+			snapshot[11] = cpu_to_fdt32(readl((const volatile uint32_t *)(idma + 0x14)));
+			snapshot[12] = cpu_to_fdt32(readl((const volatile uint32_t *)(idma + 0x18)));
+			snapshot[13] = cpu_to_fdt32(readl((const volatile uint32_t *)(idma + 0x40)));
+			snapshot[14] = cpu_to_fdt32(readl((const volatile uint32_t *)(idma_base + 0x40)));
+		}
+	}
+
+publish:
+	if (fdt_setprop_inplace(fdt, chosen, prop, snapshot, sizeof(snapshot)))
+		printk(KERN_ERR, "SM-G955N: failed to publish DECON snapshot\n");
+}
+
+/*
  * Report the inherited GPU power configuration without touching the CMU
  * or changing regulator settings. Enabled only by diagnostic DTBs.
  */
@@ -84,10 +155,13 @@
 	uint32_t pmu_status;
 	int len;
 
-	if (chosen < 0 || !fdt_getprop(fdt, chosen, property, &len) ||
-	    len != sizeof(snapshot))
+	if (chosen < 0)
 		return;
+	dream2lteks_record_decon(fdt, chosen);
 
+	if (!fdt_getprop(fdt, chosen, property, &len) || len != sizeof(snapshot))
+		return;
+
