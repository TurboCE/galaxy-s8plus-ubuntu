+#if defined(BCMPCIE_OOB_HOST_WAKE) && defined(DHD_PCIE_RUNTIMEPM)
+static bool dhdpcie_system_wake_opt_in(void)
+{
+#ifdef CONFIG_OF
+	return of_property_read_bool(of_root, "samsung,system-wlan-wake-opt-in");
+#else
+	return false;
+#endif
+}
+
+static int dhdpcie_attach_system_wake(dhdpcie_info_t *pch)
+{
+	dhdpcie_os_info_t *os = pch->os_cxt;
+	struct device *dev = &pch->dev->dev;
+	int ret;
+
+	if (!dhdpcie_system_wake_opt_in() || !device_may_wakeup(dev) ||
+	    !os->oob_irq_registered || os->oob_irq_num <= 0)
+		return 0;
+
+	ret = dev_pm_set_wake_irq(dev, os->oob_irq_num);
+	if (!ret)
+		os->system_wake_attached = true;
+	return ret;
+}
+
+static void dhdpcie_detach_system_wake(dhdpcie_info_t *pch)
+{
+	dhdpcie_os_info_t *os = pch->os_cxt;
+
+	if (os->system_wake_attached) {
+		dev_pm_clear_wake_irq(&pch->dev->dev);
+		os->system_wake_attached = false;
+	}
+}
+#endif
+
