-		else
-			exynos_wakeup_sys_powerdown(pm_info->suspend_mode_idx, pm_info->is_early_wakeup);
-	}
-
+	pr_info("%s: restoring mode %u (early wake: %d)\n", EXYNOS_PM_PREFIX,
+		pm_info->active_mode_idx, pm_info->is_early_wakeup);
+	exynos_wakeup_sys_powerdown(pm_info->active_mode_idx,
+				    pm_info->is_early_wakeup);
 	exynos_show_wakeup_reason(pm_info->is_early_wakeup);
-
-	if (!pm_info->is_early_wakeup)
-		pr_debug("%s %s: post sleep, preparing to return\n",
-						EXYNOS_PM_PREFIX, __func__);
+	pr_info("%s: restored mode %u\n", EXYNOS_PM_PREFIX,
+		pm_info->active_mode_idx);
 }
 
