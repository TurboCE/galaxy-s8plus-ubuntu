+
+#ifdef CONFIG_DRM_EXYNOS8895_NATIVE
+int decon_drm_claim(struct decon_device *decon)
+{
+	mutex_lock(&decon->lock);
+	decon->drm_owned = true;
+	mutex_unlock(&decon->lock);
+	/* Legacy submissions that acquired the lock first must finish. */
+	flush_kthread_worker(&decon->up.worker);
+	return 0;
+}
+
+void decon_drm_release(struct decon_device *decon)
+{
+	struct fb_info *info = decon->win[decon->dt.dft_win]->fbinfo;
+
+	mutex_lock(&decon->lock);
+	if (!decon->drm_owned) {
+		mutex_unlock(&decon->lock);
+		return;
+	}
+	decon->drm_owned = false;
+	mutex_unlock(&decon->lock);
+	if (check_decon_state(decon))
+		decon_pan_display(&info->var, info);
+}
+
+int decon_drm_power(struct decon_device *decon, bool enabled)
+{
+	return decon_blank(enabled ? FB_BLANK_UNBLANK : FB_BLANK_POWERDOWN,
+			   decon->win[decon->dt.dft_win]->fbinfo);
+}
+
+int decon_drm_present(struct decon_device *decon,
+		      const struct decon_drm_frame *frame)
+{
+	struct decon_reg_data *regs;
+	struct decon_win_config_data *data;
+	struct decon_win_config *config;
+	int ret, i, j;
+
+	if (!frame || !frame->buffer ||
+	    frame->width != decon->lcd_info->xres ||
+	    frame->height != decon->lcd_info->yres ||
+	    frame->pitch < frame->width * 4 || frame->pitch % 4 ||
+	    frame->pitch > 4096 * 4 ||
+	    (u64)frame->pitch * frame->height > frame->buffer->size)
+		return -EINVAL;
+	regs = kzalloc(sizeof(*regs), GFP_KERNEL);
+	data = kzalloc(sizeof(*data), GFP_KERNEL);
+	if (!regs || !data) {
+		kfree(regs);
+		kfree(data);
+		return -ENOMEM;
+	}
+	config = &data->config[0];
+	config->state = DECON_WIN_STATE_BUFFER;
+	config->fd_idma[0] = -1;
+	config->fd_idma[1] = -1;
+	config->fd_idma[2] = -1;
+	config->fence_fd = -1;
+	config->plane_alpha = 255;
+	config->idma_type = IDMA_G1;
+	config->format = frame->format;
+	config->src.w = frame->width;
+	config->src.h = frame->height;
+	config->src.f_w = frame->pitch / 4;
+	config->src.f_h = frame->height;
+	config->dst = config->src;
+	config->dst.f_w = frame->width;
+	regs->drm_buffer = frame->buffer;
+	regs->drm_status = -EIO;
+
+	decon_hiber_block_exit(decon);
+	mutex_lock(&decon->lock);
+	if (!decon->drm_owned || !check_decon_state(decon) ||
+	    decon->state == DECON_STATE_TUI) {
+		/* Capture a temporary blank under the same lock as its state.
+		 * An unblank may finish before the caller sees this return. */
+		ret = decon->drm_owned && decon->state == DECON_STATE_OFF ?
+			-EAGAIN : -EHOSTDOWN;
+		goto unlock;
+	}
+	ret = decon_prepare_win_config(decon, data, regs);
+	if (ret) {
+		for (i = 0; i < decon->dt.max_win; i++)
+			for (j = 0; j < regs->plane_cnt[i]; j++)
+				decon_free_dma_buf(decon, &regs->dma_buf_data[i][j]);
+		goto unlock;
+	}
+	/* Share the DECON update sequence, but keep all references in-kernel.
+	 * No fd is created in the worker's process and no pixel is mapped.
+	 */
+	decon->timeline_max++;
+	decon_update_regs(decon, regs);
+	ret = regs->drm_status;
+	regs->drm_buffer = NULL;
+	memcpy(&decon->last_win_update, regs, sizeof(*regs));
+unlock:
+	mutex_unlock(&decon->lock);
+	decon_hiber_unblock(decon);
+	kfree(data);
+	kfree(regs);
+	return ret;
+}
+#endif
