Subject: Abort suspend when a noirq power domain refuses to power off

The SM-G955N deep sleep log reports a DPU shutdown failure before the
system proceeds into Exynos sleep. The old genpd noirq path discards
that error and marks the domain off. Preserve its real state, propagate
the error and restore the current device before the PM core unwinds the
rest of suspend. Preserve parent counts if the failure occurs upstairs.

--- a/drivers/base/power/domain.c
+++ b/drivers/base/power/domain.c
@@ -581,26 +581,36 @@
  * executed sequentially, so it is guaranteed that it will never run twice in
  * parallel).
  */
-static void pm_genpd_sync_poweroff(struct generic_pm_domain *genpd,
+static int pm_genpd_sync_poweroff(struct generic_pm_domain *genpd,
 				   bool timed)
 {
 	struct gpd_link *link;
+	int ret;
 
 	if (genpd->status == GPD_STATE_POWER_OFF)
-		return;
+		return 0;
 
 	if (genpd->suspended_count != genpd->device_count
 	    || atomic_read(&genpd->sd_count) > 0)
-		return;
-
-	genpd_power_off(genpd, timed);
+		return 0;
+
+	ret = genpd_power_off(genpd, timed);
+	if (ret)
+		return ret;
 
 	genpd->status = GPD_STATE_POWER_OFF;
 
+	/* Account for every parent before one of their power-off calls can fail. */
+	list_for_each_entry(link, &genpd->slave_links, slave_node)
+		genpd_sd_counter_dec(link->master);
+
 	list_for_each_entry(link, &genpd->slave_links, slave_node) {
-		genpd_sd_counter_dec(link->master);
-		pm_genpd_sync_poweroff(link->master, timed);
-	}
+		ret = pm_genpd_sync_poweroff(link->master, timed);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
 }
 
 /**
@@ -785,6 +795,7 @@
 static int pm_genpd_suspend_noirq(struct device *dev)
 {
 	struct generic_pm_domain *genpd;
+	int ret;
 
 	dev_dbg(dev, "%s()\n", __func__);
 
@@ -796,7 +807,9 @@
 	    || (dev->power.wakeup_path && genpd_dev_active_wakeup(genpd, dev)))
 		return 0;
 
-	genpd_stop_dev(genpd, dev);
+	ret = genpd_stop_dev(genpd, dev);
+	if (ret)
+		return ret;
 
 	/*
 	 * Since all of the "noirq" callbacks are executed sequentially, it is
@@ -804,9 +817,15 @@
 	 * the same PM domain, so it is not necessary to use locking here.
 	 */
 	genpd->suspended_count++;
-	pm_genpd_sync_poweroff(genpd, true);
-
-	return 0;
+	ret = pm_genpd_sync_poweroff(genpd, true);
+	if (ret) {
+		/* The PM core only resumes devices whose suspend succeeded. */
+		pm_genpd_sync_poweron(genpd, true);
+		genpd->suspended_count--;
+		genpd_start_dev(genpd, dev);
+	}
+
+	return ret;
 }
 
