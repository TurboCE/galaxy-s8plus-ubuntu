@@ -32,6 +32,7 @@
     enum:
       - samsung,exynos8895-cmu-fsys0
       - samsung,exynos8895-cmu-fsys1
+      - samsung,exynos8895-cmu-g3d
       - samsung,exynos8895-cmu-peric0
       - samsung,exynos8895-cmu-peric1
       - samsung,exynos8895-cmu-peris
@@ -44,6 +45,10 @@
   clock-names:
     minItems: 1
     maxItems: 16
+
+  samsung,pmu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: PMU that reports the G3D domain power state.
 
   "#clock-cells":
     const: 1
@@ -59,6 +64,24 @@
   - "#clock-cells"
 
 allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: samsung,exynos8895-cmu-g3d
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External reference clock (26 MHz)
+            - description: G3D switch clock from CMU_TOP
+        clock-names:
+          items:
+            - const: oscclk
+            - const: switch
+      required:
+        - samsung,pmu
+
   - if:
       properties:
         compatible:
diff --git a/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml b/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
--- a/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
+++ b/Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml
@@ -32,6 +32,7 @@
               - rockchip,rk3562-mali
               - rockchip,rk3568-mali
               - rockchip,rk3576-mali
+              - samsung,exynos8895-mali
           - const: arm,mali-bifrost # Mali Bifrost GPU model/revision is fully discoverable
       - items:
           - enum:
