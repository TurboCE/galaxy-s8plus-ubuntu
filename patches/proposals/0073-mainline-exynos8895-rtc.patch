Subject: [PATCH] rtc: s3c: support the Exynos8895 always-on RTC

Wire the Samsung alarm and calendar registers into the standard RTC
class. The downstream Exynos8 driver leaves the bus clock to the
always-on domain and uses the S3C6410 alarm interrupt layout.

The SM-G955N board opts in; leave the SoC node disabled by default.

diff --git a/drivers/rtc/rtc-s3c.c b/drivers/rtc/rtc-s3c.c
--- a/drivers/rtc/rtc-s3c.c
+++ b/drivers/rtc/rtc-s3c.c
@@ -47,6 +47,7 @@
 };
 
 struct s3c_rtc_data {
+	bool bus_clk_optional;
 	bool needs_src_clk;
 
 	void (*irq_handler) (struct s3c_rtc *info, int mask);
@@ -412,7 +413,10 @@
 	if (IS_ERR(info->base))
 		return PTR_ERR(info->base);
 
-	info->rtc_clk = devm_clk_get(&pdev->dev, "rtc");
+	if (info->data->bus_clk_optional)
+		info->rtc_clk = devm_clk_get_optional(&pdev->dev, "rtc");
+	else
+		info->rtc_clk = devm_clk_get(&pdev->dev, "rtc");
 	if (IS_ERR(info->rtc_clk))
 		return dev_err_probe(&pdev->dev, PTR_ERR(info->rtc_clk),
 				     "failed to find rtc clock\n");
@@ -538,6 +542,14 @@
 	.disable		= s3c6410_rtc_disable,
 };
 
+/* Exynos8 has no driver-managed RTC clock in the always-on domain. */
+static const struct s3c_rtc_data exynos8895_rtc_data = {
+	.bus_clk_optional	= true,
+	.irq_handler		= s3c6410_rtc_irq,
+	.enable			= s3c6410_rtc_enable,
+	.disable		= s3c6410_rtc_disable,
+};
+
 static const __maybe_unused struct of_device_id s3c_rtc_dt_match[] = {
 	{
 		.compatible = "samsung,s3c6410-rtc",
@@ -546,6 +558,10 @@
 		.compatible = "samsung,exynos3250-rtc",
 		.data = &s3c6410_rtc_data,
 	},
+	{
+		.compatible = "samsung,exynos8895-rtc",
+		.data = &exynos8895_rtc_data,
+	},
 	{ /* sentinel */ },
 };
 MODULE_DEVICE_TABLE(of, s3c_rtc_dt_match);
diff --git a/Documentation/devicetree/bindings/rtc/s3c-rtc.yaml b/Documentation/devicetree/bindings/rtc/s3c-rtc.yaml
--- a/Documentation/devicetree/bindings/rtc/s3c-rtc.yaml
+++ b/Documentation/devicetree/bindings/rtc/s3c-rtc.yaml
@@ -14,6 +14,7 @@
     oneOf:
       - enum:
           - samsung,s3c6410-rtc
+          - samsung,exynos8895-rtc
       - items:
           - enum:
               - samsung,exynos7-rtc
diff --git a/arch/arm64/boot/dts/exynos/exynos8895.dtsi b/arch/arm64/boot/dts/exynos/exynos8895.dtsi
--- a/arch/arm64/boot/dts/exynos/exynos8895.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos8895.dtsi
@@ -197,6 +197,14 @@
 				     <GIC_SPI 464 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 465 IRQ_TYPE_LEVEL_HIGH>,
 				     <GIC_SPI 466 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		rtc: rtc@16490000 {
+			compatible = "samsung,exynos8895-rtc";
+			reg = <0x16490000 0x100>;
+			interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
+			status = "disabled";
 		};
 
 		gic: interrupt-controller@10201000 {
diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
@@ -126,6 +126,11 @@
 };
 
 /* Display and touch regulators. Keep disabled in the initial boot probe. */
+&rtc {
+	wakeup-source;
+	status = "okay";
+};
+
 &hsi2c_16 {
 	#address-cells = <1>;
 	#size-cells = <0>;
