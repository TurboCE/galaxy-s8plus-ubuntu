Subject: [PATCH] clk: describe inherited SM-G955N ABOX audio clocks

Expose the firmware-programmed PLL, AUDIF and both codec serializer
dividers using CCF. Decode the signed PLL_1061X fractional field and
the divider widths from Samsung's Exynos8895 CAL tables. Check the
PMU status before reading the CMU. The provider does not change rates
or gate clocks, and leaves the existing explicit power test separate.

diff --git a/drivers/soc/samsung/g955n-abox-power-test.c b/drivers/soc/samsung/g955n-abox-power-test.c
--- a/drivers/soc/samsung/g955n-abox-power-test.c
+++ b/drivers/soc/samsung/g955n-abox-power-test.c
@@ -1,6 +1,10 @@
 // SPDX-License-Identifier: GPL-2.0-only
+#include <dt-bindings/clock/samsung,exynos8895-abox.h>
+#include <linux/bitfield.h>
 #include <linux/bitops.h>
+#include <linux/clk-provider.h>
 #include <linux/io.h>
+#include <linux/math64.h>
 #include <linux/mfd/syscon.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -14,12 +18,137 @@
 #define ABOX_LOCAL_PWR		GENMASK(3, 0)
 #define ABOX_CA7_RETENTION	BIT(16)
 #define AUD_PLL_CON0		0x120
+#define AUD_PLL_CON3		0x12c
+#define AUD_PLL_ENABLE		BIT(31)
+#define AUD_PLL_STABLE		BIT(29)
+#define AUD_PLL_M		GENMASK(25, 16)
+#define AUD_PLL_P		GENMASK(13, 8)
+#define AUD_PLL_S		GENMASK(2, 0)
 #define AUDIF_DIV		0x1800
 #define UAIF0_DIV		0x1828
+#define UAIF4_DIV		0x1838
 
 static bool probe_power;
 module_param(probe_power, bool, 0400);
 MODULE_PARM_DESC(probe_power, "Exercise only the SM-G955N ABOX power domain");
+
+struct g955n_abox_clk {
+	struct clk_hw hw;
+	struct regmap *pmu;
+	void __iomem *cmu;
+	unsigned int reg;
+	unsigned int mask;
+};
+
+static unsigned long g955n_abox_clock_rate(struct clk_hw *hw,
+					  unsigned long parent_rate)
+{
+	struct g955n_abox_clk *clock = container_of(hw, struct g955n_abox_clk, hw);
+	unsigned int status, con, m, p, s;
+	int scaled_multiplier;
+
+	if (regmap_read(clock->pmu, ABOX_STATUS, &status) ||
+	    (status & ABOX_LOCAL_PWR) != ABOX_LOCAL_PWR)
+		return 0;
+
+	con = readl(clock->cmu + clock->reg);
+	if (clock->mask)
+		return parent_rate / ((con & clock->mask) + 1);
+
+	/* Samsung PLL_1061X uses a signed 16-bit fractional multiplier. */
+	if ((con & (AUD_PLL_ENABLE | AUD_PLL_STABLE)) !=
+	    (AUD_PLL_ENABLE | AUD_PLL_STABLE))
+		return 0;
+
+	m = FIELD_GET(AUD_PLL_M, con);
+	p = FIELD_GET(AUD_PLL_P, con);
+	s = FIELD_GET(AUD_PLL_S, con);
+	scaled_multiplier = (m << 16) + (s16)readl(clock->cmu + AUD_PLL_CON3);
+	if (!p || scaled_multiplier <= 0)
+		return 0;
+
+	return div64_u64((u64)parent_rate * scaled_multiplier, (u64)p << (16 + s));
+}
+
+static const struct clk_ops g955n_abox_clk_ops = {
+	.recalc_rate = g955n_abox_clock_rate,
+};
+
+static int g955n_abox_register_clocks(struct device *dev, struct regmap *pmu,
+				    void __iomem *cmu)
+{
+	static const struct {
+		const char *name;
+		unsigned int reg;
+		unsigned int mask;
+		unsigned int parent;
+	} clocks[] = {
+		[G955N_ABOX_CLK_PLL] = { "g955n-aud-pll", AUD_PLL_CON0 },
+		[G955N_ABOX_CLK_AUDIF] = {
+			"g955n-audif", AUDIF_DIV, GENMASK(8, 0), G955N_ABOX_CLK_PLL,
+		},
+		[G955N_ABOX_CLK_UAIF0] = {
+			"g955n-uaif0-bclk-div", UAIF0_DIV, GENMASK(4, 0), G955N_ABOX_CLK_AUDIF,
+		},
+		[G955N_ABOX_CLK_UAIF4] = {
+			"g955n-uaif4-bclk-div", UAIF4_DIV, GENMASK(4, 0), G955N_ABOX_CLK_AUDIF,
+		},
+	};
+	const struct clk_parent_data oscillator = { .fw_name = "oscclk" };
+	struct clk_hw_onecell_data *data;
+	struct g955n_abox_clk *hw_clocks;
+	unsigned int i;
+	int ret;
+
+	data = devm_kzalloc(dev, struct_size(data, hws, ARRAY_SIZE(clocks)), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+
+	hw_clocks = devm_kcalloc(dev, ARRAY_SIZE(clocks), sizeof(*hw_clocks), GFP_KERNEL);
+	if (!hw_clocks)
+		return -ENOMEM;
+
+	for (i = 0; i < ARRAY_SIZE(clocks); i++) {
+		struct g955n_abox_clk *clock = &hw_clocks[i];
+		const struct clk_hw *parent;
+		struct clk_init_data init = {
+			.name = clocks[i].name,
+			.ops = &g955n_abox_clk_ops,
+			.flags = CLK_GET_RATE_NOCACHE,
+			.num_parents = 1,
+		};
+
+		if (i == G955N_ABOX_CLK_PLL) {
+			init.parent_data = &oscillator;
+		} else {
+			parent = data->hws[clocks[i].parent];
+			init.parent_hws = &parent;
+		}
+
+		clock->hw.init = &init;
+		clock->pmu = pmu;
+		clock->cmu = cmu;
+		clock->reg = clocks[i].reg;
+		clock->mask = clocks[i].mask;
+
+		ret = devm_clk_hw_register(dev, &clock->hw);
+		if (ret)
+			return dev_err_probe(dev, ret, "cannot register %s\n", init.name);
+
+		data->hws[i] = &clock->hw;
+	}
+
+	data->num = ARRAY_SIZE(clocks);
+	ret = devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, data);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < data->num; i++)
+		dev_info(dev, "%s rate %lu Hz\n", clocks[i].name,
+			 clk_hw_get_rate(data->hws[i]));
+
+	return 0;
+}
 
 static int g955n_abox_wait(struct regmap *pmu, unsigned int target)
 {
@@ -57,7 +186,7 @@
 		dev_info(dev, "inherited ABOX clocks: PLL=%#x AUDIF=%#x UAIF0=%#x\n",
 			 readl(cmu + AUD_PLL_CON0), readl(cmu + AUDIF_DIV),
 			 readl(cmu + UAIF0_DIV));
-		return 0;
+		return g955n_abox_register_clocks(dev, pmu, cmu);
 	}
 	if (!probe_power)
 		return 0;
diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
@@ -149,6 +149,9 @@
 	abox-power-test@13e00000 {
 		compatible = "samsung,sm-g955n-abox-power-test";
 		reg = <0x13e00000 0x4000>;
+		clocks = <&oscclk>;
+		clock-names = "oscclk";
+		#clock-cells = <1>;
 		samsung,pmu = <&pmu_system_controller>;
 	};
 
diff --git a/include/dt-bindings/clock/samsung,exynos8895-abox.h b/include/dt-bindings/clock/samsung,exynos8895-abox.h
new file mode 100644
--- /dev/null
+++ b/include/dt-bindings/clock/samsung,exynos8895-abox.h
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+#ifndef _DT_BINDINGS_CLOCK_SAMSUNG_EXYNOS8895_ABOX_H
+#define _DT_BINDINGS_CLOCK_SAMSUNG_EXYNOS8895_ABOX_H
+
+#define G955N_ABOX_CLK_PLL	0
+#define G955N_ABOX_CLK_AUDIF	1
+#define G955N_ABOX_CLK_UAIF0	2
+#define G955N_ABOX_CLK_UAIF4	3
+
+#endif
