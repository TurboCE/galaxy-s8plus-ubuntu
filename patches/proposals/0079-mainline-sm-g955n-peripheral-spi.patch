Subject: [PATCH] arm64: dts: exynos8895: enable the SM-G955N peripheral SPI hosts

Enable the SPI paths for the CS47L93 codec and BCM4773 hub.
Select the USI modes and chip select pins wired on this board.

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
@@ -381,3 +381,25 @@
 		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
 	};
 };
+
+&usi1 {
+	samsung,mode = <USI_MODE_SPI>;
+	status = "okay";
+};
+
+&spi_3 {
+	cs-gpios = <&gpd1 6 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&spi3_bus &spi3_cs>;
+	status = "okay";
+};
+
+&usi8 {
+	samsung,mode = <USI_MODE_SPI>;
+	status = "okay";
+};
+
+&spi_10 {
+	cs-gpios = <&gpe2 6 GPIO_ACTIVE_LOW>;
+	pinctrl-0 = <&spi10_bus &spi10_cs>;
+	status = "okay";
+};
