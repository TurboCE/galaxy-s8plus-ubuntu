diff --git a/drivers/soc/samsung/g955n-abox-dma-probe.c b/drivers/soc/samsung/g955n-abox-dma-probe.c
new file mode 100644
--- /dev/null
+++ b/drivers/soc/samsung/g955n-abox-dma-probe.c
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/dma-mapping.h>
+#include <linux/iommu.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/sizes.h>
+
+static int g955n_abox_dma_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct iommu_domain *domain;
+	struct page *pages;
+	dma_addr_t iova;
+	phys_addr_t physical;
+	unsigned long offset;
+	int ret;
+
+	if (!of_machine_is_compatible("samsung,dream2lteks"))
+		return -ENODEV;
+
+	domain = iommu_get_domain_for_dev(dev);
+	if (!domain || !iommu_is_dma_domain(domain))
+		return dev_err_probe(dev, -ENODEV, "ABOX requires a translated DMA domain\n");
+
+	/* Keep the exclusive end of a PCM ring in the 32-bit register. */
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(31));
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot restrict the ABOX DMA aperture\n");
+
+	pages = alloc_pages(GFP_KERNEL | __GFP_ZERO, get_order(SZ_64K));
+	if (!pages)
+		return -ENOMEM;
+
+	iova = dma_map_page(dev, pages, 0, SZ_64K, DMA_BIDIRECTIONAL);
+	if (dma_mapping_error(dev, iova)) {
+		ret = -EIO;
+		goto free;
+	}
+
+	physical = page_to_phys(pages);
+	if ((iova & 15) || iova > U32_MAX - SZ_64K) {
+		ret = -ERANGE;
+		goto unmap;
+	}
+
+	for (offset = 0; offset < SZ_64K; offset += PAGE_SIZE) {
+		if (iommu_iova_to_phys(domain, iova + offset) != physical + offset) {
+			ret = -EIO;
+			goto unmap;
+		}
+	}
+
+	dev_info(dev, "verified 64 KiB of translated 32-bit ABOX DMA addresses\n");
+	ret = 0;
+unmap:
+	dma_unmap_page(dev, iova, SZ_64K, DMA_BIDIRECTIONAL);
+free:
+	__free_pages(pages, get_order(SZ_64K));
+	return ret ? dev_err_probe(dev, ret, "ABOX DMA mapping check failed\n") : 0;
+}
+
+static const struct of_device_id g955n_abox_dma_of_match[] = {
+	{ .compatible = "samsung,sm-g955n-abox-dma-probe" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, g955n_abox_dma_of_match);
+
+static struct platform_driver g955n_abox_dma_driver = {
+	.probe = g955n_abox_dma_probe,
+	.driver = {
+		.name = "g955n-abox-dma-probe",
+		.of_match_table = g955n_abox_dma_of_match,
+	},
+};
+module_platform_driver(g955n_abox_dma_driver);
+
+MODULE_DESCRIPTION("SM-G955N ABOX translated DMA mapping check");
+MODULE_LICENSE("GPL");
