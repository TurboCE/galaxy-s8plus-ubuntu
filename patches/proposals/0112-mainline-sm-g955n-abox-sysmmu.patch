Subject: [PATCH] iommu: connect SM-G955N ABOX to the native Exynos System MMU

Connect the stock audio System MMU and its CMU bus gate. Check
that the audio DSP and DMA engines are idle before enabling the
clock. Qualify mappings through the standard DMA API and require
the entire 32-bit buffer to translate to the allocated pages.

diff --git a/drivers/soc/samsung/g955n-abox-power-test.c b/drivers/soc/samsung/g955n-abox-power-test.c
--- a/drivers/soc/samsung/g955n-abox-power-test.c
+++ b/drivers/soc/samsung/g955n-abox-power-test.c
@@ -40,6 +40,10 @@
 #define ABOX_UAIF0_CTRL		0x0500
 #define ABOX_UAIF4_CTRL		0x0540
 #define ABOX_UAIF_ENABLE		GENMASK(1, 0)
+#define ABOX_SYSMMU_GATE	0x20b0
+#define ABOX_RDMA_CTRL(n)	(0x1000 + 0x100 * (n))
+#define ABOX_WDMA_CTRL(n)	(0x2000 + 0x100 * (n))
+#define ABOX_DMA_ENABLE		BIT(0)
 
 static bool probe_uaif_clock;
 module_param(probe_uaif_clock, bool, 0400);
@@ -55,6 +59,7 @@
 	void __iomem *cmu;
 	void __iomem *sfr;
 	unsigned int uaif_ctrl;
+	u32 gate_before;
 	unsigned int reg;
 	unsigned int mask;
 };
@@ -199,6 +204,64 @@
 		 clk_hw_get_name(hw), actual, previous);
 	return 0;
 }
+
+static int g955n_abox_sysmmu_prepare(struct clk_hw *hw)
+{
+	struct g955n_abox_clk *clock = container_of(hw, struct g955n_abox_clk, hw);
+	const u32 mask = ABOX_GATE_ACTIVE | ABOX_GATE_MANUAL | ABOX_GATE_AUTO;
+	unsigned int status, i;
+	u32 value;
+	int ret;
+
+	ret = regmap_read(clock->pmu, ABOX_STATUS, &status);
+	if (ret || (status & ABOX_LOCAL_PWR) != ABOX_LOCAL_PWR)
+		return ret ?: -EHOSTDOWN;
+
+	ret = regmap_read(clock->pmu, ABOX_CA7_STATUS, &status);
+	if (ret || (status & ABOX_CA7_RUNNING))
+		return ret ?: -EBUSY;
+
+	value = readl(clock->cmu + ABOX_ACLK_GATE);
+	if ((value & ABOX_GATE_MANUAL ? !(value & ABOX_GATE_ACTIVE) :
+	     (value & ABOX_GATE_AUTO)) ||
+	    readl(clock->sfr + ABOX_IP_INDEX) != ABOX_HW_ID)
+		return -ENODEV;
+
+	/* The System MMU can only be taken over while the DMA engines are idle. */
+	for (i = 0; i < 8; i++)
+		if (readl(clock->sfr + ABOX_RDMA_CTRL(i)) & ABOX_DMA_ENABLE)
+			return -EBUSY;
+	for (i = 0; i < 5; i++)
+		if (readl(clock->sfr + ABOX_WDMA_CTRL(i)) & ABOX_DMA_ENABLE)
+			return -EBUSY;
+
+	value = readl(clock->cmu + ABOX_SYSMMU_GATE);
+	clock->gate_before = value & mask;
+	writel((value & ~mask) | ABOX_GATE_ACTIVE | ABOX_GATE_MANUAL,
+	       clock->cmu + ABOX_SYSMMU_GATE);
+
+	return 0;
+}
+
+static void g955n_abox_sysmmu_unprepare(struct clk_hw *hw)
+{
+	struct g955n_abox_clk *clock = container_of(hw, struct g955n_abox_clk, hw);
+	const u32 mask = ABOX_GATE_ACTIVE | ABOX_GATE_MANUAL | ABOX_GATE_AUTO;
+	unsigned int status;
+	u32 value;
+
+	if (regmap_read(clock->pmu, ABOX_STATUS, &status) ||
+	    (status & ABOX_LOCAL_PWR) != ABOX_LOCAL_PWR)
+		return;
+
+	value = readl(clock->cmu + ABOX_SYSMMU_GATE);
+	writel((value & ~mask) | clock->gate_before, clock->cmu + ABOX_SYSMMU_GATE);
+}
+
+static const struct clk_ops g955n_abox_sysmmu_ops = {
+	.prepare = g955n_abox_sysmmu_prepare,
+	.unprepare = g955n_abox_sysmmu_unprepare,
+};
 
 static int g955n_abox_register_clocks(struct device *dev, struct regmap *pmu,
 				    void __iomem *cmu, void __iomem *sfr)
@@ -222,6 +285,7 @@
 			"g955n-uaif4-bclk-div", UAIF4_DIV, GENMASK(4, 0),
 			G955N_ABOX_CLK_AUDIF, ABOX_UAIF4_CTRL,
 		},
+		[G955N_ABOX_CLK_SYSMMU] = { "g955n-abox-sysmmu" },
 	};
 	const struct clk_parent_data oscillator = { .fw_name = "oscclk" };
 	struct clk_hw_onecell_data *data;
@@ -252,7 +316,11 @@
 			init.flags |= CLK_SET_RATE_GATE;
 		}
 
-		if (i == G955N_ABOX_CLK_PLL) {
+		if (i == G955N_ABOX_CLK_SYSMMU) {
+			init.ops = &g955n_abox_sysmmu_ops;
+			init.flags = 0;
+			init.num_parents = 0;
+		} else if (i == G955N_ABOX_CLK_PLL) {
 			init.parent_data = &oscillator;
 		} else {
 			parent = data->hws[clocks[i].parent];
@@ -287,7 +355,7 @@
 	if (ret)
 		return ret;
 
-	for (i = 0; i < data->num; i++)
+	for (i = 0; i < G955N_ABOX_CLK_SYSMMU; i++)
 		dev_info(dev, "%s rate %lu Hz\n", clocks[i].name,
 			 clk_hw_get_rate(data->hws[i]));
 
