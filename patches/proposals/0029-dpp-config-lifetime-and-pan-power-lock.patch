-static int dpp_set_config(struct dpp_device *dpp)
+/* Callers retain their buffers, but DPP owns the configuration metadata used
+ * after this ioctl by IRQ/debug/timer paths. Caller storage is not retained. */
+static void dpp_copy_config(struct dpp_device *dpp,
+        const struct decon_win_config *config)
+{
+    dpp->config = *config;
+}
+
+static int dpp_set_config(struct dpp_device *dpp,
+        const struct decon_win_config *config)
 {
 	struct dpp_params_info params;
 	int ret = 0;
 
 	mutex_lock(&dpp->lock);
+	if (!config) {
+		ret = -EINVAL;
+		goto err;
+	}
+	dpp_copy_config(dpp, config);
 
 	/* parameters from decon driver are translated for dpp driver */
 	dpp_get_params(dpp, &params);
