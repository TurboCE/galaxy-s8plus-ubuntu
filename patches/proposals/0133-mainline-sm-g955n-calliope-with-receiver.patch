+static int abox_get_uaif0(struct g955n_speaker *abox, struct clk *bclk)
+{
+	void __iomem *sfr = abox->sfr;
+	int ret;
+
+	lockdep_assert_held(&abox->prepare_lock);
+	if (abox->uaif0_users) {
+		abox->uaif0_users++;
+		return 0;
+	}
+
+	if (readl(sfr + CAP_UAIF0) & UAIF_STREAM_ENABLES)
+		return -EBUSY;
+	abox->saved_uaif0_bclk = clk_get_rate(bclk);
+	if (!abox->saved_uaif0_bclk)
+		return -EIO;
+	abox->saved_uaif0_ctrl0 = readl(sfr + CAP_UAIF0);
+	abox->saved_uaif0_ctrl1 = readl(sfr + CAP_UAIF0 + 4);
+	abox->saved_uaif0_gate = readl(abox->cmu + CAP_GATE);
+
+	ret = clk_set_rate(bclk, BCLK_RATE);
+	if (ret || clk_get_rate(bclk) != BCLK_RATE) {
+		clk_set_rate(bclk, abox->saved_uaif0_bclk);
+		return ret ?: -EIO;
+	}
+	abox_update(abox->cmu, CAP_GATE, GATE_MASK, GATE_ON);
+	abox_update(sfr, CAP_UAIF0, UAIF0_MODE, UAIF0_MODE);
+	abox_update(sfr, CAP_UAIF0 + 4, GENMASK(28, 0), UAIF0_FORMAT);
+	abox->uaif0_users++;
+	return 0;
+}
+
+static int abox_put_uaif0(struct g955n_speaker *abox, struct clk *bclk)
+{
+	int ret;
+
+	lockdep_assert_held(&abox->prepare_lock);
+	if (--abox->uaif0_users)
+		return 0;
+
+	writel(abox->saved_uaif0_ctrl1, abox->sfr + CAP_UAIF0 + 4);
+	writel(abox->saved_uaif0_ctrl0, abox->sfr + CAP_UAIF0);
+	writel(abox->saved_uaif0_gate, abox->cmu + CAP_GATE);
+	ret = clk_set_rate(bclk, abox->saved_uaif0_bclk);
+	if (!ret && clk_get_rate(bclk) != abox->saved_uaif0_bclk)
+		ret = -EIO;
+	return ret;
+}
+
+static void abox_get_stream_power(struct g955n_speaker *abox)
+{
+	lockdep_assert_held(&abox->prepare_lock);
+	if (abox->prepared_count++)
+		return;
+	abox->saved_syspower = readl(abox->sfr + SYSPOWER_CTRL);
+	abox_update(abox->sfr, SYSPOWER_CTRL, BIT(0), BIT(0));
+}
+
+static void abox_put_stream_power(struct g955n_speaker *abox)
+{
+	lockdep_assert_held(&abox->prepare_lock);
+	if (!--abox->prepared_count)
+		writel(abox->saved_syspower, abox->sfr + SYSPOWER_CTRL);
+}
