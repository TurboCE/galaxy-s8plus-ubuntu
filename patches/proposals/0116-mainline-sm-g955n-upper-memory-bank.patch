Subject: [PATCH] arm64: dts: exynos8895: add the SM-G955N upper DRAM bank

Use the 2 GiB bank at 0x880000000 described by Samsung's SM-G955N
device tree. Retain the reserved regions and low-address DECON pool.

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
@@ -34,11 +34,11 @@
 		};
 	};
 
-	/* Common low memory banks are enough for the initramfs test. */
 	memory@80000000 {
 		device_type = "memory";
 		reg = <0 0x80000000 0x3c800000>,
-		      <0 0xc0000000 0x40000000>;
+		      <0 0xc0000000 0x40000000>,
+		      <8 0x80000000 0x80000000>;
 	};
 
 	reserved-memory {
