Subject: [PATCH] SM-G955N: describe the STMFTS touchscreen

Expose the board STMFTS device on HSI2C23 with the Samsung GPIO and
SM-G955N panel dimensions. The test loader powers its two fixed-voltage
supplies before Linux starts. Pair with the SM-G955N touch loader patch.

diff --git a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
@@ -277,3 +277,53 @@
 		reg = <0x25>;
 	};
 };
+
+/ {
+	tsp_io: regulator-touch-io {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp-io";
+		regulator-min-microvolt = <1850000>;
+		regulator-max-microvolt = <1850000>;
+		regulator-always-on;
+	};
+
+	tsp_avdd: regulator-touch-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp-avdd";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+};
+
+&usi9 {
+	samsung,mode = <USI_MODE_I2C>;
+	status = "okay";
+};
+
+&hsi2c_23 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	touchscreen@49 {
+		compatible = "st,stmfts";
+		reg = <0x49>;
+		interrupt-parent = <&gpa1>;
+		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&dream2lteks_touch_irq>;
+		vdd-supply = <&tsp_io>;
+		avdd-supply = <&tsp_avdd>;
+		touchscreen-size-x = <1440>;
+		touchscreen-size-y = <2960>;
+	};
+};
+
+&pinctrl_alive {
+	dream2lteks_touch_irq: touchscreen-irq-pins {
+		samsung,pins = "gpa1-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+	};
+};
