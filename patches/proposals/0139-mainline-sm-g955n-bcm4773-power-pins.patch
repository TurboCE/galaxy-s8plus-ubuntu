Subject: [PATCH] arm64: dts: exynos: mux the dream2lteks sensor hub enable

Samsung's Korean rev10 DT uses GPA4-6 as a GPIO output for the
BCM4773 hub power gate. On mainline the bootloader left that pad in
function 2, so the SSI driver could not read or restore its GPIO
direction. Select GPIO output with a low idle level in the hub's
default pinctrl state, matching the off state of Samsung's SSP driver.

This qualifies asserting the gate before an SSI transaction. An
SSP chip-ID reply remains unverified.

--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
@@ -578,4 +578,10 @@
 		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
 		samsung,pin-drv = <3>;
 	};
+	g955n_hub_power: hub-rev10-enable-pins {
+		samsung,pins = "gpa4-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-val = <0>;
+	};
 };
@@ -593,7 +599,8 @@
 		spi-cpol;
 		spi-cpha;
 		pinctrl-names = "default";
-		pinctrl-0 = <&g955n_hub_req &g955n_hub_resp &g955n_hub_host_req>;
+		pinctrl-0 = <&g955n_hub_req &g955n_hub_resp &g955n_hub_host_req
+			     &g955n_hub_power>;
 		vddio-supply = <&g955n_hub_1v8>;
 		rev10-enable-gpios = <&gpa4 6 GPIO_ACTIVE_HIGH>;
 		gnss-enable-gpios = <&gpf0 3 GPIO_ACTIVE_HIGH>;
