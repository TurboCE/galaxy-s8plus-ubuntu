+#define UAIF_STREAM_ENABLES GENMASK(1, 0)
+#define UAIF0_MODE (BIT(2) | BIT(4))
+#define UAIF0_FORMAT ((9 << 24) | BIT(23) | (1 << 18) | (15 << 12))
+#define RECEIVER_PCM 2
+#define PCM_COUNT 3
 #define MICBIAS1_SOFT_START	BIT(3)
 #define MICBIAS1_BYPASS		BIT(1)

