Subject: [PATCH] drm/panfrost: unwind incomplete GPU page mappings

Propagate short mappings and page-table allocation failures to callers.
Roll back the range including pages installed by the failing call, then
flush it before reuse. For a failed heap chunk, also release its DMA
mapping, scatterlist and page references under the reservation lock.
Carry the mapping error into the fault record.

Adapt the 6.18 mapping paths using the upstream error-handling work by
Adrián Larumbe and Arun Iyengar as reference:
https://lore.kernel.org/r/20251019145225.3621989-7-adrian.larumbe@collabora.com
https://lore.kernel.org/dri-devel/20261113-panfrost-long-jobs-v3-5-80ae78d38f6e@gmail.com/

diff --git a/drivers/gpu/drm/panfrost/panfrost_mmu.c b/drivers/gpu/drm/panfrost/panfrost_mmu.c
--- a/drivers/gpu/drm/panfrost/panfrost_mmu.c
+++ b/drivers/gpu/drm/panfrost/panfrost_mmu.c
@@ -399,6 +399,7 @@
 	struct scatterlist *sgl;
 	struct io_pgtable_ops *ops = mmu->pgtbl_ops;
 	u64 start_iova = iova;
+	int ret;
 
 	for_each_sgtable_dma_sg(sgt, sgl, count) {
 		unsigned long paddr = sg_dma_address(sgl);
@@ -410,11 +411,13 @@
 			size_t pgcount, mapped = 0;
 			size_t pgsize = get_pgsize(iova | paddr, len, &pgcount);
 
-			ops->map_pages(ops, iova, paddr, pgsize, pgcount, prot,
-				       GFP_KERNEL, &mapped);
-			/* Don't get stuck if things have gone wrong */
-			mapped = max(mapped, pgsize);
+			ret = ops->map_pages(ops, iova, paddr, pgsize, pgcount,
+					     prot, GFP_KERNEL, &mapped);
 			iova += mapped;
+			if (ret || mapped != pgsize * pgcount) {
+				ret = ret ?: -EIO;
+				goto err_unmap;
+			}
 			paddr += mapped;
 			len -= mapped;
 		}
@@ -423,6 +426,24 @@
 	panfrost_mmu_flush_range(pfdev, mmu, start_iova, iova - start_iova);
 
 	return 0;
+
+err_unmap:
+	if (iova != start_iova) {
+		size_t len = iova - start_iova;
+		u64 addr = start_iova;
+
+		while (addr < iova) {
+			size_t pgcount, pgsize;
+
+			pgsize = get_pgsize(addr, iova - addr, &pgcount);
+			if (WARN_ON(ops->unmap_pages(ops, addr, pgsize, pgcount,
+						   NULL) != pgsize * pgcount))
+				break;
+			addr += pgsize * pgcount;
+		}
+		panfrost_mmu_flush_range(pfdev, mmu, start_iova, len);
+	}
+	return ret;
 }
 
 int panfrost_mmu_map(struct panfrost_gem_mapping *mapping)
@@ -433,6 +454,7 @@
 	struct panfrost_device *pfdev = to_panfrost_device(obj->dev);
 	struct sg_table *sgt;
 	int prot = IOMMU_READ | IOMMU_WRITE | IOMMU_CACHE;
+	int ret;
 
 	if (WARN_ON(mapping->active))
 		return 0;
@@ -441,11 +463,14 @@
 		prot |= IOMMU_NOEXEC;
 
 	sgt = drm_gem_shmem_get_pages_sgt(shmem);
-	if (WARN_ON(IS_ERR(sgt)))
+	if (IS_ERR(sgt))
 		return PTR_ERR(sgt);
 
-	mmu_map_sg(pfdev, mapping->mmu, mapping->mmnode.start << PAGE_SHIFT,
-		   prot, sgt);
+	ret = mmu_map_sg(pfdev, mapping->mmu, mapping->mmnode.start << PAGE_SHIFT,
+			 prot, sgt);
+	if (ret)
+		return ret;
+
 	mapping->active = true;
 
 	return 0;
@@ -606,34 +631,29 @@
 	mapping = bo->base.base.filp->f_mapping;
 	mapping_set_unevictable(mapping);
 
+	sgt = &bo->sgts[page_offset / NUM_FAULT_PAGES];
 	for (i = page_offset; i < page_offset + NUM_FAULT_PAGES; i++) {
-		/* Can happen if the last fault only partially filled this
-		 * section of the pages array before failing. In that case
-		 * we skip already filled pages.
-		 */
-		if (pages[i])
-			continue;
-
 		pages[i] = shmem_read_mapping_page(mapping, i);
 		if (IS_ERR(pages[i])) {
 			ret = PTR_ERR(pages[i]);
 			pages[i] = NULL;
-			goto err_unlock;
-		}
-	}
-
-	sgt = &bo->sgts[page_offset / (SZ_2M / PAGE_SIZE)];
+			goto err_pages;
+		}
+	}
+
 	ret = sg_alloc_table_from_pages(sgt, pages + page_offset,
 					NUM_FAULT_PAGES, 0, SZ_2M, GFP_KERNEL);
 	if (ret)
-		goto err_unlock;
+		goto err_pages;
 
 	ret = dma_map_sgtable(pfdev->dev, sgt, DMA_BIDIRECTIONAL, 0);
 	if (ret)
 		goto err_map;
 
-	mmu_map_sg(pfdev, bomapping->mmu, addr,
-		   IOMMU_WRITE | IOMMU_READ | IOMMU_CACHE | IOMMU_NOEXEC, sgt);
+	ret = mmu_map_sg(pfdev, bomapping->mmu, addr,
+			 IOMMU_WRITE | IOMMU_READ | IOMMU_CACHE | IOMMU_NOEXEC, sgt);
+	if (ret)
+		goto err_dma;
 
 	bomapping->active = true;
 	bo->heap_rss_size += SZ_2M;
@@ -647,8 +667,18 @@
 
 	return 0;
 
+err_dma:
+	dma_unmap_sgtable(pfdev->dev, sgt, DMA_BIDIRECTIONAL, 0);
 err_map:
 	sg_free_table(sgt);
+err_pages:
+	*sgt = (struct sg_table){};
+	for (i = page_offset; i < page_offset + NUM_FAULT_PAGES; i++) {
+		if (pages[i]) {
+			put_page(pages[i]);
+			pages[i] = NULL;
+		}
+	}
 err_unlock:
 	dma_resv_unlock(obj->resv);
 err_bo:
@@ -844,7 +874,7 @@
 		mmu_write(pfdev, MMU_INT_CLEAR, mask);
 
 		/* Page fault only */
-		ret = -1;
+		ret = -EOPNOTSUPP;
 		if ((status & mask) == BIT(as) && (exception_type & 0xF8) == 0xC0)
 			ret = panfrost_mmu_map_fault_addr(pfdev, as, addr);
 
@@ -852,14 +882,14 @@
 			/* terminal fault, print info about the fault */
 			dev_err(pfdev->dev,
 				"Unhandled Page fault in AS%d at VA 0x%016llX\n"
-				"Reason: %s\n"
+				"Page map error: %pe\n"
 				"raw fault status: 0x%X\n"
 				"decoded fault status: %s\n"
 				"exception type 0x%X: %s\n"
 				"access type 0x%X: %s\n"
 				"source id 0x%X\n",
 				as, addr,
-				"TODO",
+				ERR_PTR(ret),
 				fault_status,
 				(fault_status & (1 << 10) ? "DECODER FAULT" : "SLAVE FAULT"),
 				exception_type, panfrost_exception_name(exception_type),
