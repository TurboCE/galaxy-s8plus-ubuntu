From: SM-G955N Ubuntu port contributors
Subject: [PATCH] PCI: exynos: validate clock counts and check the indexed PHY clock

Clock lookup stores PHY handles at i - pcie_clk_num but checked phy_clks[i].
A failed lookup can pass unnoticed, and valid DT counts can produce an
out-of-bounds read of the three-entry PHY array. Check the same slot that
was assigned and report its PHY-relative index. Bound both DT counts against
their actual arrays before summing/indexing; zero-clock platforms stay valid.

Preserve existing error returns and clock-enable/disable control flow. This
is not the separate transactional clock-enable/error-unwind proposal; no
CONFIG_SEC_PANIC_PCIE_ERR behavior is changed. Applies after patch 0024,
whose success-log changes do not overlap these clock-lookup hunks.

--- a/drivers/pci/host/pci-exynos.c
+++ b/drivers/pci/host/pci-exynos.c
@@ -366,6 +366,17 @@
 	struct exynos_pcie_clks	*clks = &exynos_pcie->clks;
 	int i, total_clk_num, phy_count;
 
+	/* DT counts index fixed-size storage below. Validate before addition or
+	 * lookup, retaining zero clocks for platforms that require none. */
+	if (exynos_pcie->pcie_clk_num < 0 ||
+	    exynos_pcie->pcie_clk_num > (int)ARRAY_SIZE(clks->pcie_clks) ||
+	    exynos_pcie->phy_clk_num < 0 ||
+	    exynos_pcie->phy_clk_num > (int)ARRAY_SIZE(clks->phy_clks)) {
+		dev_err(pp->dev, "Invalid clock counts: pcie=%d phy=%d\n",
+			exynos_pcie->pcie_clk_num, exynos_pcie->phy_clk_num);
+		return -EINVAL;
+	}
+
 	/*
 	 * CAUTION - PCIe and phy clock have to define in order.
 	 * You must define related PCIe clock first in DT.
@@ -376,14 +387,14 @@
 		if (i < exynos_pcie->pcie_clk_num) {
 			clks->pcie_clks[i] = of_clk_get(pp->dev->of_node, i);
 			if (IS_ERR(clks->pcie_clks[i])) {
-				dev_err(pp->dev, "Failed to get pcie clock\n");
+				dev_err(pp->dev, "Failed to get pcie clock[%d]\n", i);
 				return -ENODEV;
 			}
 		} else {
 			phy_count = i - exynos_pcie->pcie_clk_num;
 			clks->phy_clks[phy_count] = of_clk_get(pp->dev->of_node, i);
-			if (IS_ERR(clks->phy_clks[i])) {
-				dev_err(pp->dev, "Failed to get pcie clock\n");
+			if (IS_ERR(clks->phy_clks[phy_count])) {
+				dev_err(pp->dev, "Failed to get phy clock[%d]\n", phy_count);
 				return -ENODEV;
 			}
 		}
