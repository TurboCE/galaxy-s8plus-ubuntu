From: SM-G955N Ubuntu port contributors
Subject: [PATCH] OF: append native overrides after Samsung boot arguments

S-Boot ignores this image header cmdline and replaces DT bootargs. The
port uses CMDLINE_EXTEND to retain all firmware memory/calibration arguments
while appending its native overrides last. Never force away firmware args.
This deliberately gives the G955N port overrides precedence over S-Boot.

diff --git a/drivers/of/fdt.c b/drivers/of/fdt.c
--- a/drivers/of/fdt.c
+++ b/drivers/of/fdt.c
@@ -997,14 +997,13 @@ int __init early_init_dt_scan_chosen(unsigned long node, const char *uname,
 
 	if (p != NULL && l > 0) {
 		if (concat_cmdline) {
-			int cmdline_len;
-			int copy_len;
+			/* Samsung S-Boot replaces the Android header command line.
+			 * Retain every firmware argument first, then append this
+			 * native port's console/security overrides with precedence.
+			 */
+			strlcpy(cmdline, p, min((int)l, COMMAND_LINE_SIZE));
 			strlcat(cmdline, " ", COMMAND_LINE_SIZE);
-			cmdline_len = strlen(cmdline);
-			copy_len = COMMAND_LINE_SIZE - cmdline_len - 1;
-			copy_len = min((int)l, copy_len);
-			strncpy(cmdline + cmdline_len, p, copy_len);
-			cmdline[cmdline_len + copy_len] = '\0';
+			strlcat(cmdline, config_cmdline, COMMAND_LINE_SIZE);
 		} else {
 			strlcpy(cmdline, p, min((int)l, COMMAND_LINE_SIZE));
 		}
