Subject: [PATCH] Exynos8895: add embedded UFS host and M-PHY bring-up

Use the Samsung Exynos8895 UFS v4 register layout and board wiring.
Keep initial traffic at PWM G1 while high-speed calibration and resume
await hardware validation.

Calibration source: arch/arm64/boot/dts/exynos/exynos8895.dtsi
Copyright (c) 2014 Samsung Electronics Co., Ltd.
Vendor reference revision: 54feaea9 (R64).

diff --git a/drivers/phy/samsung/phy-exynos8895-ufs.c b/drivers/phy/samsung/phy-exynos8895-ufs.c
new file mode 100644
--- /dev/null
+++ b/drivers/phy/samsung/phy-exynos8895-ufs.c
@@ -0,0 +1,53 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Exynos8895 PMA calibration from the Samsung Exynos8895 device tree. */
+#include <linux/delay.h>
+#include "phy-samsung-ufs.h"
+
+#define EXYNOS8895_LANE_STRIDE 0x140
+
+static const struct samsung_ufs_phy_cfg exynos8895_pre_init[] = {
+	PHY_COMN_REG_CFG(0x23, 0x80, PWR_MODE_ANY),
+	PHY_COMN_REG_CFG(0x1d, 0x10, PWR_MODE_ANY),
+	PHY_TRSV_REG_CFG_OFFSET(0x44, 0xb5, PWR_MODE_ANY,
+				EXYNOS8895_LANE_STRIDE / 4),
+	PHY_TRSV_REG_CFG_OFFSET(0x4d, 0x43, PWR_MODE_ANY,
+				EXYNOS8895_LANE_STRIDE / 4),
+	PHY_TRSV_REG_CFG_OFFSET(0x5b, 0x20, PWR_MODE_ANY,
+				EXYNOS8895_LANE_STRIDE / 4),
+	PHY_TRSV_REG_CFG_OFFSET(0x5e, 0xc0, PWR_MODE_ANY,
+				EXYNOS8895_LANE_STRIDE / 4),
+	PHY_TRSV_REG_CFG_OFFSET(0x38, 0x12, PWR_MODE_ANY,
+				EXYNOS8895_LANE_STRIDE / 4),
+	PHY_TRSV_REG_CFG_OFFSET(0x59, 0x58, PWR_MODE_ANY,
+				EXYNOS8895_LANE_STRIDE / 4),
+	PHY_COMN_REG_CFG(0x23, 0xc0, PWR_MODE_ANY),
+	PHY_COMN_REG_CFG(0x23, 0x0, PWR_MODE_ANY),
+	END_UFS_PHY_CFG,
+};
+
+static int exynos8895_wait_for_calibration(struct phy *phy, u8 lane)
+{
+	/* This M-PHY requires 200 us after releasing PMA reset. */
+	if (!lane)
+		usleep_range(200, 250);
+	return 0;
+}
+
+static const struct samsung_ufs_phy_cfg *exynos8895_ufs_cfgs[CFG_TAG_MAX] = {
+	[CFG_PRE_INIT] = exynos8895_pre_init,
+};
+
+static const char * const exynos8895_ufs_clocks[] = { "ref_clk" };
+
+const struct samsung_ufs_phy_drvdata exynos8895_ufs_phy = {
+	.cfgs = exynos8895_ufs_cfgs,
+	.isol = {
+		.offset = 0x724,
+		.mask = BIT(0),
+		.en = BIT(0),
+	},
+	.clk_list = exynos8895_ufs_clocks,
+	.num_clks = ARRAY_SIZE(exynos8895_ufs_clocks),
+	.wait_for_cal = exynos8895_wait_for_calibration,
+	.defer_init_calibration = true,
+};
