+
+/* UniPro and PCS setup from the Exynos8895 UFS v4 vendor tables. */
+enum exynos8895_ufs_target {
+	EXYNOS8895_MIB,
+	EXYNOS8895_RX,
+	EXYNOS8895_TX,
+	EXYNOS8895_UNIPRO_PERIOD,
+	EXYNOS8895_RX_PERIOD,
+	EXYNOS8895_TX_PERIOD,
+};
+
+struct exynos8895_ufs_attr {
+	u16 attr;
+	u32 value;
+	enum exynos8895_ufs_target target;
+};
+
+static const struct exynos8895_ufs_attr exynos8895_before_link[] = {
+	{ 0x9514, 0x0, EXYNOS8895_UNIPRO_PERIOD },
+	{ 0x0200, 0x40, EXYNOS8895_MIB },
+	{ 0x0012, 0x0, EXYNOS8895_RX_PERIOD },
+	{ 0x00aa, 0x0, EXYNOS8895_TX_PERIOD },
+	{ 0x005c, 0x38, EXYNOS8895_RX },
+	{ 0x000f, 0x0, EXYNOS8895_RX },
+	{ 0x0065, 0x1, EXYNOS8895_RX },
+	{ 0x0069, 0x1, EXYNOS8895_RX },
+	{ 0x0021, 0x0, EXYNOS8895_RX },
+	{ 0x0022, 0x0, EXYNOS8895_RX },
+	{ 0x0084, 0x1, EXYNOS8895_RX },
+	{ 0x0004, 0x1, EXYNOS8895_TX },
+	{ 0x0200, 0x0, EXYNOS8895_MIB },
+	{ 0x9536, 0x4e20, EXYNOS8895_MIB },
+	{ 0x9564, 0x2e820183, EXYNOS8895_MIB },
+	{ 0x155e, 0x0, EXYNOS8895_MIB },
+	{ 0x3000, 0x0, EXYNOS8895_MIB },
+	{ 0x3001, 0x1, EXYNOS8895_MIB },
+	{ 0x4021, 0x1, EXYNOS8895_MIB },
+	{ 0x4020, 0x1, EXYNOS8895_MIB },
+};
+
+static const struct exynos8895_ufs_attr exynos8895_after_link[] = {
+	{ 0x9529, 0x1, EXYNOS8895_MIB },
+	{ 0x15a4, 0xfa, EXYNOS8895_MIB },
+	{ 0x9529, 0x0, EXYNOS8895_MIB },
+	{ 0x0200, 0x40, EXYNOS8895_MIB },
+	{ 0x0035, 0x5, EXYNOS8895_RX },
+	{ 0x0073, 0x1, EXYNOS8895_RX },
+	{ 0x0041, 0x2, EXYNOS8895_RX },
+	{ 0x0042, 0xac, EXYNOS8895_RX },
+	{ 0x0200, 0x0, EXYNOS8895_MIB },
+};
+
+
+static int exynos8895_ufs_write_attrs(struct exynos_ufs *ufs,
+				    const struct exynos8895_ufs_attr *attrs,
+				    size_t count)
+{
+	unsigned int lanes, first;
+	u32 value;
+	int ret;
+
+	for (; count; attrs++, count--) {
+		value = attrs->value;
+		first = 0;
+		lanes = 1;
+		switch (attrs->target) {
+		case EXYNOS8895_UNIPRO_PERIOD:
+			value = NSEC_PER_SEC / ufs->mclk_rate;
+			break;
+		case EXYNOS8895_RX_PERIOD:
+			value = NSEC_PER_SEC / ufs->pclk_rate;
+			fallthrough;
+		case EXYNOS8895_RX:
+			first = PA_MAXDATALANES;
+			lanes = ufs->avail_ln_rx;
+			break;
+		case EXYNOS8895_TX_PERIOD:
+			value = NSEC_PER_SEC / ufs->pclk_rate;
+			fallthrough;
+		case EXYNOS8895_TX:
+			lanes = ufs->avail_ln_tx;
+			break;
+		case EXYNOS8895_MIB:
+			break;
+		}
+
+		for (unsigned int i = 0; i < lanes; i++) {
+			ret = ufshcd_dme_set(ufs->hba,
+					UIC_ARG_MIB_SEL(attrs->attr, first + i), value);
+			if (ret)
+				return dev_err_probe(ufs->hba->dev, ret,
+					"UFS MIB %#x selector %u\n", attrs->attr, first + i);
+		}
+	}
+
+	return 0;
+}
+
+#define EXYNOS8895_SMC_FMP_SECURITY 0xc2001810
+#define EXYNOS8895_SMC_SMU          0xc2001830
+#define EXYNOS8895_UFS_EMBEDDED     0
+#define EXYNOS8895_PRDT_STANDARD    0
+#define EXYNOS8895_SMU_INIT         0
+
+static int exynos8895_ufs_init_smu(struct exynos_ufs *ufs)
+{
+	struct arm_smccc_res res;
+
+	/* The secure monitor owns the protector on Exynos8895. */
+	arm_smccc_smc(EXYNOS8895_SMC_FMP_SECURITY, 0, EXYNOS8895_UFS_EMBEDDED,
+		      EXYNOS8895_PRDT_STANDARD, 0, 0, 0, 0, &res);
+	if (res.a0)
+		return dev_err_probe(ufs->hba->dev, -EIO,
+				     "UFS firmware descriptor setup failed: %ld\n", res.a0);
+
+	arm_smccc_smc(EXYNOS8895_SMC_SMU, EXYNOS8895_SMU_INIT,
+		      EXYNOS8895_UFS_EMBEDDED, 0, 0, 0, 0, 0, &res);
+	if (res.a0)
+		return dev_err_probe(ufs->hba->dev, -EIO,
+				     "UFS firmware SMU init failed: %ld\n", res.a0);
+
+	return 0;
+}
+
+static int exynos8895_ufs_init(struct exynos_ufs *ufs)
+{
+	int ret;
+
+	if (!ufs->sysreg)
+		return -ENODEV;
+	ret = regmap_update_bits(ufs->sysreg, 0x1150, BIT(0), BIT(0));
+	if (ret)
+		return ret;
+	ret = exynos_ufs_shareability(ufs);
+	if (ret)
+		return ret;
+	return exynos8895_ufs_init_smu(ufs);
+}
+
+static int exynos8895_ufs_enable_clocks(struct exynos_ufs *ufs)
+{
+	u32 val;
+
+	val = hci_readl(ufs, HCI_MPHY_REFCLK_SEL);
+	hci_writel(ufs, val | BIT(0), HCI_MPHY_REFCLK_SEL);
+	val = hci_readl(ufs, HCI_UFS_ACG_DISABLE);
+	hci_writel(ufs, val | BIT(0), HCI_UFS_ACG_DISABLE);
+
+	/* Exynos8895 keeps the host core running while enabling gating controls. */
+	val = hci_readl(ufs, HCI_MISC);
+	val |= BIT(11) | BIT(10) | BIT(8) | BIT(7) | BIT(6) | BIT(5);
+	hci_writel(ufs, val & ~HCI_CORECLK_CTRL_EN, HCI_MISC);
+	return 0;
+}
+
+static int exynos8895_ufs_init_link_phy(struct exynos_ufs *ufs)
+{
+	int ret;
+
+	if (!ufs->avail_ln_rx || ufs->avail_ln_rx > 2 ||
+	    !ufs->avail_ln_tx || ufs->avail_ln_tx > 2)
+		return dev_err_probe(ufs->hba->dev, -EINVAL,
+				     "UFS invalid PHY lanes rx=%u tx=%u\n",
+				     ufs->avail_ln_rx, ufs->avail_ln_tx);
+
+	/* The vendor table configures PCS before releasing the PMA reset. */
+	ret = exynos8895_ufs_write_attrs(ufs, exynos8895_before_link,
+					ARRAY_SIZE(exynos8895_before_link));
+	if (ret)
+		return ret;
+
+	ret = phy_calibrate(ufs->phy);
+	if (ret)
+		return dev_err_probe(ufs->hba->dev, ret, "UFS PMA calibration failed\n");
+
+	dev_info(ufs->hba->dev, "UFS PCS and PMA ready, rx=%u tx=%u clock=%lu\n",
+		 ufs->avail_ln_rx, ufs->avail_ln_tx, ufs->mclk_rate);
+	return 0;
+}
+
