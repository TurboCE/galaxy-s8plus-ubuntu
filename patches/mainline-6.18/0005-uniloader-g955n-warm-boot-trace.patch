--- /dev/null
+++ b/include/main/g955n-boot-trace.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef G955N_BOOT_TRACE_H
+#define G955N_BOOT_TRACE_H
+
+#ifdef CONFIG_SAMSUNG_DREAM2LTEKS
+#include <stdint.h>
+
+static inline void g955n_boot_trace(const char *stage)
+{
+	volatile uint32_t *header = (volatile uint32_t *)0x92004000UL;
+	volatile char *data = (volatile char *)(header + 3);
+	uint64_t el, control;
+	unsigned int size;
+
+	asm volatile("mrs %0, CurrentEL" : "=r"(el));
+	if (el == 8)
+		asm volatile("mrs %0, sctlr_el2" : "=r"(control));
+	else
+		asm volatile("mrs %0, sctlr_el1" : "=r"(control));
+	if (control & 1)
+		return;
+
+	size = header[2];
+	if (header[0] != 0x43474244 || size < 16 || size > 56 ||
+	    header[1] != size)
+		return;
+	for (unsigned int i = 0; i < 8; i++)
+		if (data[i] != "G955N61\n"[i])
+			return;
+
+	for (unsigned int i = 0; i < 8; i++)
+		data[size + i] = stage[i];
+
+	/* Commit the payload before publishing its length to recovery. */
+	asm volatile("dc cvac, %0; dc cvac, %1; dsb sy"
+		     :: "r"(data + size), "r"(data + size + 7) : "memory");
+	header[1] = size + 8;
+	header[2] = size + 8;
+	asm volatile("dc cvac, %0; dsb sy" :: "r"(header) : "memory");
+}
+#else
+static inline void g955n_boot_trace(const char *stage) { }
+#endif
+
+#endif
