Subject: uniLoader: record SM-G955N milestones in the recovery pmsg ring

--- a/arch/aarch64/reloc.S
+++ b/arch/aarch64/reloc.S
@@ -26,6 +26,37 @@
 	.quad _reloc_size
 
 ENTRY_ALIAS( _reloc_entry)
+#ifdef CONFIG_SAMSUNG_DREAM2LTEKS
+	/* Only use physical addresses on an MMU-off handoff. */
+	mrs	x9, CurrentEL
+	cmp	x9, #8
+	mrs	x10, sctlr_el1
+	b.ne	.Lg955n_loader_mmu
+	mrs	x10, sctlr_el2
+.Lg955n_loader_mmu:
+	tbnz	x10, #0, .Lg955n_loader_trace_done
+	/* The recovery pmsg buffer is the second 16 KiB of log_pstore. */
+	movz	x9, #0x4000
+	movk	x9, #0x9200, lsl #16
+	str	wzr, [x9]
+	ldr	w10, =0x35353947
+	ldr	w11, =0xa31364e
+	str	w10, [x9, #12]
+	str	w11, [x9, #16]
+	ldr	w10, =0x44414f4c
+	ldr	w11, =0xa315245
+	str	w10, [x9, #20]
+	str	w11, [x9, #24]
+	mov	w10, #16
+	stp	w10, w10, [x9, #4]
+	ldr	w10, =0x43474244
+	str	w10, [x9]
+	dc	cvac, x9
+	add	x10, x9, #24
+	dc	cvac, x10
+	dsb	sy
+.Lg955n_loader_trace_done:
+#endif
 	adr	x4, _start
 	ldr	x5, _rel_stack_base
 	cmp	x4, x5
