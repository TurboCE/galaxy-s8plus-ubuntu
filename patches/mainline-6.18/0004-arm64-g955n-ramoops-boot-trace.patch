Subject: arm64: retain SM-G955N diagnostic boot milestones across recovery

--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -137,6 +137,14 @@
 	select SOC_SAMSUNG
 	help
 	  This enables support for ARMv8 based Samsung Exynos SoC family.
+
+config EXYNOS8895_G955N_BOOT_TRACE
+	bool "Trace the early kernel handoff on Samsung SM-G955N"
+	depends on ARCH_EXYNOS && !CPU_BIG_ENDIAN
+	help
+	  In a dedicated SM-G955N diagnostic image, append a milestone to
+	  the verified Exynos Snapshot ramoops area if uniLoader initialized
+	  the trace and entered the kernel with the MMU off.
 
 config ARCH_K3
 	bool "Texas Instruments Inc. K3 multicore SoC architecture"
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -83,6 +83,54 @@
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
 SYM_CODE_START(primary_entry)
+#ifdef CONFIG_EXYNOS8895_G955N_BOOT_TRACE
+	/* Do not touch the physical buffer on an MMU-on entry. */
+	mrs	x12, CurrentEL
+	mrs	x13, sctlr_el1
+	cmp	x12, #CurrentEL_EL2
+	b.ne	.Lg955n_trace_mmu
+	mrs	x13, sctlr_el2
+.Lg955n_trace_mmu:
+	tbnz	x13, #0, .Lg955n_trace_done	/* SCTLR_ELx.M */
+	movz	x9, #0x4000
+	movk	x9, #0x9200, lsl #16
+	ldr	w10, [x9]
+	ldr	w11, =0x43474244
+	cmp	w10, w11
+	b.ne	.Lg955n_trace_done
+	ldp	w10, w11, [x9, #4]
+	cmp	w10, w11
+	b.ne	.Lg955n_trace_done
+	cmp	w10, #40
+	b.lo	.Lg955n_trace_done
+	cmp	w10, #56
+	b.hi	.Lg955n_trace_done
+	tst	w10, #7
+	b.ne	.Lg955n_trace_done
+	add	x14, x9, x10
+	ldr	w11, [x14, #4]
+	ldr	w12, =0x444e4148
+	cmp	w11, w12
+	b.ne	.Lg955n_trace_done
+	ldr	w11, [x14, #8]
+	ldr	w12, =0x0a46464f
+	cmp	w11, w12
+	b.ne	.Lg955n_trace_done
+	ldr	w11, =0x554e494c
+	ldr	w12, =0x0a212158
+	str	w11, [x14, #12]
+	str	w12, [x14, #16]
+	add	x13, x14, #12
+	dc	cvac, x13
+	add	x13, x14, #16
+	dc	cvac, x13
+	dsb	sy
+	add	w10, w10, #8
+	stp	w10, w10, [x9, #4]
+	dc	cvac, x9
+	dsb	sy
+.Lg955n_trace_done:
+#endif
 	bl	record_mmu_state
 	bl	preserve_boot_args
 
--- a/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
+++ b/arch/arm64/boot/dts/exynos/exynos8895-dream2lteks.dts
@@ -42,6 +42,14 @@
 		#address-cells = <2>;
 		#size-cells = <1>;
 		ranges;
+
+		/* Preserve the vendor 16 KiB dump and 16 KiB pmsg layout. */
+		ramoops@92000000 {
+			compatible = "ramoops";
+			reg = <0 0x92000000 0x8000>;
+			record-size = <0x4000>;
+			console-size = <0x4000>;
+		};
 
 		framebuffer@cc000000 {
 			reg = <0 0xcc000000 (1440 * 2960 * 4)>;
