From: SM-G955N Ubuntu port contributors
Subject: [PATCH] ASoC: VTS: load supplied firmware before runtime resume

Probe resumes VTS immediately after queuing firmware asynchronously. This
failed before native root mount and never made a successful initial resume.
Use direct firmware loading from the native initramfs, defer a missing blob,
validate the version offset and preserve parsed version fields.

diff --git a/sound/soc/samsung/vts/vts.c b/sound/soc/samsung/vts/vts.c
--- a/sound/soc/samsung/vts/vts.c
+++ b/sound/soc/samsung/vts/vts.c
@@ -2032,6 +2032,7 @@ static int samsung_vts_probe(struct platform_device *pdev)
 	struct device *dev = &pdev->dev;
 	struct device_node *np = dev->of_node;
 	struct vts_data *data;
+	const struct firmware *firmware;
 	int result;
 	int dmic_clkctrl = 0;
 
@@ -2225,17 +2226,22 @@ static int samsung_vts_probe(struct platform_device *pdev)
 		goto error;
 	}
 
-	result = request_firmware_nowait(THIS_MODULE,
-			FW_ACTION_HOTPLUG,
-			"vts.bin",
-			dev,
-			GFP_KERNEL,
-			pdev,
-			vts_complete_firmware_request);
-	if (IS_ERR_VALUE(result)) {
-		dev_err(dev, "Failed to request firmware\n");
+	/* Native initramfs supplies firmware before probe. Do not let runtime
+	 * resume race an asynchronous request, or wait for a userspace helper
+	 * before PID 1 exists. Missing firmware can be retried after root mount.
+	 */
+	result = request_firmware_direct(&firmware, "vts.bin", dev);
+	if (result) {
+		if (result == -ENOENT)
+			result = -EPROBE_DEFER;
+		goto error;
+	}
+	if (firmware->size < VTSFW_VERSION_OFFSET + sizeof(unsigned int)) {
+		release_firmware(firmware);
+		result = -EINVAL;
 		goto error;
 	}
+	vts_complete_firmware_request(firmware, pdev);
 
 	result = device_create_bin_file(dev, &bin_attr_vts_google_model);
 	if (IS_ERR_VALUE(result)) {
@@ -2272,8 +2278,6 @@ static int samsung_vts_probe(struct platform_device *pdev)
 	data->voicerecog_start = 0;
 	data->syssel_rate = 0;
 	data->target_size = 0;
-	data->vtsfw_version = 0x0;
-	data->vtsdetectlib_version = 0x0;
 	dmic_clkctrl = readl(data->sfr_base + VTS_DMIC_CLK_CTRL);
 	writel(dmic_clkctrl & ~(0x1 << VTS_CLK_ENABLE_OFFSET),
 				data->sfr_base + VTS_DMIC_CLK_CTRL);
