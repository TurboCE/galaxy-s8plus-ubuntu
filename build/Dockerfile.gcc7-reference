# Build-only compiler comparison with the kernel author's GCC 7.5 generation.
# Native AMD64 host with an ARM64 cross compiler; no handset tooling or vendor images are installed.
FROM ubuntu:18.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc-7 g++-7 gcc-7-aarch64-linux-gnu g++-7-aarch64-linux-gnu \
    make binutils binutils-aarch64-linux-gnu bc bison flex git libssl-dev libelf-dev \
    device-tree-compiler liblz4-tool xz-utils ca-certificates python python3 \
    && rm -rf /var/lib/apt/lists/*
RUN test "$(dpkg --print-architecture)" = amd64 \
    && aarch64-linux-gnu-gcc-7 -dumpversion | grep -q '^7' \
    && ln -s /usr/bin/aarch64-linux-gnu-gcc-7 /usr/local/bin/aarch64-linux-gnu-gcc \
    && ln -s /usr/bin/aarch64-linux-gnu-g++-7 /usr/local/bin/aarch64-linux-gnu-g++ \
    && ln -s /usr/bin/gcc-7 /usr/local/bin/gcc \
    && ln -s /usr/bin/g++-7 /usr/local/bin/g++
